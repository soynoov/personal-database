---
import "../styles/global.css";
import "../styles/badges.css"; // Badges: estado, launcher, plataforma, tag
import "../styles/ux.css"; // Capa de interacción y responsive; no modifica las cards
import "../styles/mobile-bottom-nav.css";
import "../styles/editor-auth.css";
import EditorAuthDialog from "../components/EditorAuthDialog.astro";
import AppShell from "../components/AppShell.astro";

type Props = {
  title?: string;
  active?: 'catalogo' | 'ruleta' | 'estadisticas' | 'datos' | 'criticas';
  pageClass?: string;
  pageStyle?: string;
  golden?: string | null;
  detail?: boolean;
};

const { title = "NooVDB", ...shellProps } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <AppShell {...shellProps}><slot /></AppShell>
    <EditorAuthDialog />
  </body>
</html>
