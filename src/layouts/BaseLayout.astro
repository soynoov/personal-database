---
import "../styles/global.css";
import "../styles/badges.css"; // Badges: estado, launcher, plataforma, tag
import "../styles/ux.css"; // Capa de interacción y responsive; no modifica las cards
import "../styles/mobile-bottom-nav.css";
import "../styles/editor-auth.css";
import EditorAuthDialog from "../components/EditorAuthDialog.astro";

type Props = {
  title?: string;
};

const { title = "EvaDB Games" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <EditorAuthDialog />
  </body>
</html>
