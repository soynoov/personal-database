---
import "../styles/global.css";
import "../styles/badges.css"; // Badges: estado, launcher, plataforma, tag
import "../styles/cards.css"; // Diseño de tarjetas del catálogo (override de global.css)
import "../styles/ux.css"; // Capa de interacción y responsive; no modifica las cards
import "../styles/catalog-mobile.css";
import "../styles/mobile-bottom-nav.css";
import "../styles/editor-auth.css";
import "../styles/game-detail/experience.css"; // Rediseño de las fichas; selectores aislados bajo .game-page-rich
import "../styles/game-detail/frosted-bento.css"; // Profundidad de vidrio y encaje bento final de las fichas
import "../styles/game-detail/ledger-layout.css"; // Jerarquía del mockup elegido, sin eliminar datos existentes
import "../styles/game-detail/hero-reference.css"; // Composición final del hero de ficha técnica
import EditorAuthDialog from "../components/EditorAuthDialog.astro";

type Props = {
  title?: string;
};

const { title = "EvaDB Games" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <EditorAuthDialog />
  </body>
</html>
