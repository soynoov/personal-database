---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameDetailChartsScript from '../../components/GameDetailChartsScript.astro';
import GameDetailHero from '../../components/game-detail/GameDetailHero.astro';
import GameDetailTopbar from '../../components/game-detail/GameDetailTopbar.astro';
import GameDetailNav from '../../components/game-detail/GameDetailNav.astro';
import GameDetailHours from '../../components/game-detail/GameDetailHours.astro';
import GameDetailFinance from '../../components/game-detail/GameDetailFinance.astro';
import GameDetailCompetitive from '../../components/game-detail/GameDetailCompetitive.astro';
import GameDetailStats from '../../components/game-detail/GameDetailStats.astro';
import GameDetailDLCs from '../../components/game-detail/GameDetailDLCs.astro';
import GameDetailComments from '../../components/game-detail/GameDetailComments.astro';
import GameDetailMetacritic from '../../components/game-detail/GameDetailMetacritic.astro';
import { buildGameCoverUrl, buildGameHeroUrl } from '../../lib/game-cover-url';
import {
  formatEuro,
  getPurchasePriceComparison,
  getGameValueMetrics,
  isAcquiredDlc,
} from '../../lib/game-finance';
import { normalizeStatus } from '../../lib/game-status';
import { formatGameModes, getGameModeLabel, getGameModes } from '../../lib/game-modes';
import { getGameGenres } from '../../lib/game-genres';
import { isCommunityCriterionApplicable } from '../../lib/game-reviews';
import { getGameTagLabel, hasGameTag, normalizeGameTag } from '../../lib/game-tags';
import { findGameBySlug, readGames } from '../../lib/local-games';
import { normalizePurchaseStores } from '../../lib/purchase-stores';
import gamepadIcon from '@tabler/icons/outline/device-gamepad-2.svg?url';

const game = findGameBySlug(await readGames(), Astro.params.slug ?? '');
if (!game) return Astro.redirect('/');

const valueMetrics = getGameValueMetrics(game);
const slug = Astro.params.slug ?? '';
const coverUrl = buildGameCoverUrl(game);
const heroImageUrl = buildGameHeroUrl(game);
const heroCoverStyle = `--hero-cover:url("${heroImageUrl.replace(/"/g, '\\"')}")`;

const formatValue = (value: unknown, fallback = '-') =>
  value === null || value === undefined || value === '' ? fallback : String(value);
const formatCurrency = (value: unknown, fallback = '-') => {
  if (value === null || value === undefined || value === '') return fallback;
  const parsed = Number(value);
  return Number.isFinite(parsed) ? formatEuro(parsed, fallback) : String(value);
};
const formatDate = (value: unknown) => {
  if (!value) return '-';
  const date = new Date(`${value}T00:00:00`);
  if (Number.isNaN(date.getTime())) return String(value);
  return new Intl.DateTimeFormat('es-ES', { day: '2-digit', month: 'long', year: 'numeric' }).format(date);
};

const statusClasses: Record<string, string> = {
  pendiente: 'badge-status-pending',
  jugando: 'badge-status-playing',
  terminado: 'badge-status-completed',
  completado: 'badge-status-completed',
  recurrente: 'badge-status-recurring',
  wishlist: 'badge-status-wishlist',
  pausado: 'badge-status-paused',
  abandonado: 'badge-status-abandoned',
  retirado: 'badge-status-abandoned',
};
const launcherClasses: Record<string, string> = {
  steam: 'badge-launcher-steam',
  'epic games': 'badge-launcher-epic',
  epic: 'badge-launcher-epic',
  nintendo: 'badge-launcher-nintendo',
  'nintendo eshop': 'badge-launcher-nintendo',
  pirata: 'badge-launcher-pirata',
  gamepass: 'badge-launcher-gamepass',
  'xbox game pass': 'badge-launcher-gamepass',
  'riot games': 'badge-launcher-riot',
  hoyoplay: 'badge-launcher-hoyoplay',
  'ea app': 'badge-launcher-ea',
  ubisoft: 'badge-launcher-ubisoft',
  'ubisoft connect': 'badge-launcher-ubisoft',
  gog: 'badge-launcher-gog',
  'itch.io': 'badge-launcher-itch',
};
const statusClass = statusClasses[normalizeStatus(game.estado)] ?? 'badge-status-default';
const launcherClass = launcherClasses[normalizeStatus(game.launcher)] ?? 'badge-launcher-default';
const platformClass = normalizeStatus(game.plataforma) === 'pc' ? 'badge-platform-pc' : 'badge-platform-default';

const gameModes = getGameModes(game);
const modesLabel = formatGameModes(gameModes);
const genresList = getGameGenres(game.generos);
const genres = genresList.length > 0 ? genresList.join(', ') : '-';
const rawTags = Array.isArray(game.tags) ? game.tags : [];
const tagBadges = rawTags
  .filter((tag) => normalizeGameTag(tag) !== 'cooperativo-privado')
  .map((tag) => ({ value: normalizeGameTag(tag), label: getGameTagLabel(tag) }));
const heroBadges = [...tagBadges];
const addHeroBadge = (value: string, label: string) => {
  if (!heroBadges.some((badge) => badge.value === value)) heroBadges.push({ value, label });
};
if (genresList.some((genre) => normalizeStatus(genre) === 'indie')) addHeroBadge('indie', 'Indie');
if (genresList.some((genre) => normalizeStatus(genre) === 'acceso anticipado')) {
  addHeroBadge('early-access', 'Early Access');
}
gameModes.forEach((mode) => addHeroBadge(`mode-${mode}`, getGameModeLabel(mode)));
const tagsLabel = tagBadges.length > 0 ? tagBadges.map((tag) => tag.label).join(', ') : 'Sin etiquetas';
const isCompetitive = hasGameTag(game.tags, 'competitivo') || Boolean(game.rango_actual || game.rango_maximo);
const includeCommunity = isCommunityCriterionApplicable(game);

const achievements = game.logros && (game.logros.actual !== null || game.logros.total !== null)
  ? `${formatValue(game.logros.actual)} / ${formatValue(game.logros.total)}`
  : '-';
const achievementProgress = game.logros?.actual !== null && game.logros?.actual !== undefined && Number(game.logros?.total) > 0
  ? Math.max(0, Math.min(100, Number(game.logros?.actual) / Number(game.logros?.total) * 100))
  : null;
const steamCards = game.steam_cromos && (game.steam_cromos.actual !== null || game.steam_cromos.total !== null)
  ? `${formatValue(game.steam_cromos.actual)} / ${formatValue(game.steam_cromos.total)}`
  : '-';
const steamCardsProgress = game.steam_cromos?.actual !== null && game.steam_cromos?.actual !== undefined && Number(game.steam_cromos?.total) > 0
  ? Math.max(0, Math.min(100, Number(game.steam_cromos?.actual) / Number(game.steam_cromos?.total) * 100))
  : null;

const dlcItems = game.dlcs?.items ?? [];
const dlcTotal = Number(game.dlcs?.total ?? dlcItems.length);
const acquiredDlcs = dlcItems.filter(isAcquiredDlc);
const pendingDlcs = dlcItems.filter((dlc) => !isAcquiredDlc(dlc));
const sumKnown = (items: typeof dlcItems, key: 'precio_pagado' | 'precio_actual' | 'precio_salida') =>
  items.reduce((total, item) => {
    const parsed = item[key] === null || item[key] === undefined ? null : Number(item[key]);
    return total + (parsed !== null && Number.isFinite(parsed) ? parsed : 0);
  }, 0);
const countKnown = (items: typeof dlcItems, key: 'precio_pagado' | 'precio_actual' | 'precio_salida') =>
  items.filter((item) => item[key] !== null && item[key] !== undefined && Number.isFinite(Number(item[key]))).length;
const dlcMarketPoints = [
  { label: 'Salida', value: sumKnown(acquiredDlcs, 'precio_salida'), count: countKnown(acquiredDlcs, 'precio_salida'), color: '#7f758d' },
  { label: 'Pagado', value: sumKnown(acquiredDlcs, 'precio_pagado'), count: countKnown(acquiredDlcs, 'precio_pagado'), color: '#b792e5' },
  { label: 'Actual', value: sumKnown(acquiredDlcs, 'precio_actual'), count: countKnown(acquiredDlcs, 'precio_actual'), color: '#8b85a2' },
].filter((point) => point.count > 0).map(({ label, value, color }) => ({ label, value: Number(value.toFixed(2)), color }));
const dlcChartPayload = dlcMarketPoints.length >= 2
  ? { type: 'market-comparison', points: dlcMarketPoints, seriesLabel: 'Contenido adicional', metric: 'currency' }
  : null;

const paidUnitPrice = game.precio_pagado === null || game.precio_pagado === undefined ? null : Number(game.precio_pagado);
const currentPrice = game.precio_actual === null || game.precio_actual === undefined ? null : Number(game.precio_actual);
const launchPrice = game.precio_salida === null || game.precio_salida === undefined ? null : Number(game.precio_salida);
const historicLow = game.precio_minimo_historico === null || game.precio_minimo_historico === undefined
  ? null
  : Number(game.precio_minimo_historico);
const purchasePriceComparison = getPurchasePriceComparison(paidUnitPrice, launchPrice);
const priceComparisonCard = purchasePriceComparison
  ? {
      label: 'Rebaja conseguida',
      value: purchasePriceComparison.direction === 'discount'
        ? `${purchasePriceComparison.percent.toLocaleString('es-ES', { maximumFractionDigits: 1 })}% más barato`
        : purchasePriceComparison.direction === 'premium'
          ? `${purchasePriceComparison.percent.toLocaleString('es-ES', { maximumFractionDigits: 1 })}% por encima`
          : 'Sin rebaja',
      note: purchasePriceComparison.direction === 'discount'
        ? `vs. precio de salida · ${formatCurrency(purchasePriceComparison.amountPerUnit)} por copia`
        : purchasePriceComparison.direction === 'premium'
          ? `vs. precio de salida · ${formatCurrency(purchasePriceComparison.amountPerUnit)} extra por copia`
          : 'Mismo precio de salida',
      className: purchasePriceComparison.direction === 'discount' ? 'is-saving' : '',
    }
  : null;
const moneyChartPoints = [
  { label: 'Salida', value: launchPrice, color: '#7f758d' },
  { label: 'Compra', value: paidUnitPrice, color: '#b792e5' },
  { label: 'Mín. histórico', value: historicLow, color: '#8da081' },
  { label: 'Actual', value: currentPrice, color: '#8b85a2' },
].filter((point): point is { label: string; value: number; color: string } => point.value !== null && Number.isFinite(point.value));
const moneyChartPayload = { type: 'market-comparison', points: moneyChartPoints, seriesLabel: 'Precio', metric: 'currency' };
const pendingDlcMarketValue = sumKnown(pendingDlcs, 'precio_actual');
const marketCards = [
  ...(priceComparisonCard ? [priceComparisonCard] : []),
  { label: 'Pagado / copia', value: formatCurrency(paidUnitPrice, '—') },
  { label: 'Precio actual', value: formatCurrency(currentPrice, '—') },
  { label: 'Precio de salida', value: formatCurrency(launchPrice, '—') },
  { label: 'Mínimo histórico', value: formatCurrency(historicLow, '—') },
  { label: 'DLC pendientes', value: pendingDlcMarketValue > 0 ? formatCurrency(pendingDlcMarketValue, '—') : '—' },
];

const hltbBreakdown = {
  main: game.hltb_breakdown?.main == null ? null : Number(game.hltb_breakdown.main),
  mainPlus: game.hltb_breakdown?.main_plus == null ? null : Number(game.hltb_breakdown.main_plus),
  completionist: game.hltb_breakdown?.completionist == null ? null : Number(game.hltb_breakdown.completionist),
};
const hltbBars = valueMetrics.showHltbTarget
  ? [
      { label: 'Historia', value: hltbBreakdown.main, color: '#81798c' },
      { label: 'Historia + extras', value: hltbBreakdown.mainPlus, color: '#9985b3' },
      { label: '100%', value: hltbBreakdown.completionist, color: '#746b80' },
    ].filter((bar): bar is { label: string; value: number; color: string } => bar.value !== null && Number.isFinite(bar.value))
  : [];
const myHoursColor = valueMetrics.realHours === null
  ? '#718096'
  : hltbBreakdown.main !== null && valueMetrics.realHours < hltbBreakdown.main
    ? '#b9777f'
    : hltbBreakdown.mainPlus !== null && valueMetrics.realHours >= hltbBreakdown.mainPlus
      ? '#8ea779'
      : '#b18d6a';
const hoursChartPayload = {
  type: 'hours-vs-hltb',
  myHours: valueMetrics.realHours,
  hltbBars,
  myHoursColor,
};

const start = game.fecha_inicio ? new Date(`${game.fecha_inicio}T00:00:00`) : null;
const end = game.fecha_fin ? new Date(`${game.fecha_fin}T00:00:00`) : null;
const elapsedDays = start && end && end >= start ? Math.round((end.getTime() - start.getTime()) / 86_400_000) : null;
const updatedDate = game.actualizado_en ? new Date(game.actualizado_en) : null;
const metadataGroups = [
  {
    title: 'Catalogación',
    className: 'data-group-catalog',
    items: [
      { label: 'Géneros', value: genres },
      { label: 'Etiquetas', value: tagsLabel === 'Sin etiquetas' ? '-' : tagsLabel },
      { label: 'Modos', value: modesLabel },
    ],
  },
  {
    title: 'Progreso',
    className: 'data-group-progress',
    items: [
      { label: 'Dificultad', value: formatValue(game.dificultad), note: game.dificultad ? 'Partida registrada' : 'Sin registrar' },
      {
        label: 'Logros', value: achievements,
        note: achievementProgress === null ? 'Sin registrar' : `${achievementProgress.toFixed(0)}% completado`,
        className: achievementProgress === null ? '' : 'detail-item-achievements', progress: achievementProgress,
      },
      {
        label: 'Cromos Steam', value: steamCards,
        note: steamCardsProgress === null ? 'Sin datos' : `${steamCardsProgress.toFixed(0)}% completado`,
        className: steamCardsProgress === null ? '' : 'detail-item-achievements', progress: steamCardsProgress,
      },
    ],
  },
  {
    title: 'Ficha técnica',
    className: 'data-group-technical',
    items: [
      { label: 'Launcher', value: formatValue(game.launcher, 'Sin launcher') },
      { label: 'Plataforma', value: formatValue(game.plataforma) },
      ...(game.tamano ? [{ label: 'Tamaño instalado', value: game.tamano }] : []),
      { label: 'Lanzamiento', value: formatValue(game.lanzamiento) },
      { label: 'Steam AppID', value: formatValue(game.steam_appid) },
      { label: 'HLTB match', value: formatValue(game.hltb_match) },
      { label: 'Última edición', value: updatedDate && !Number.isNaN(updatedDate.getTime()) ? new Intl.DateTimeFormat('es-ES', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Madrid' }).format(updatedDate) : '-' },
    ],
  },
];

const legacyScore = game.nota !== null && game.nota !== undefined && Number.isFinite(Number(game.nota)) ? Number(game.nota) : null;
const purchaseStores = normalizePurchaseStores(game.tiendas_compra);
---

<BaseLayout title={`${game.titulo} | Personal Database`}>
  <main class="shell game-page game-page-rich" style={heroCoverStyle}>
    <div class="game-page-backdrop" aria-hidden="true"></div>
    <GameDetailTopbar
      slug={slug}
      editValues={{
        estado: game.estado,
        fecha_inicio: game.fecha_inicio,
        fecha_fin: game.fecha_fin,
      }}
    />
    <GameDetailHero
      title={game.titulo}
      coverUrl={coverUrl}
      heroCoverStyle={heroCoverStyle}
      statusBadge={{ class: statusClass, label: formatValue(game.estado) }}
      launcherBadge={{ class: launcherClass, label: formatValue(game.launcher, 'Sin launcher'), icon: gamepadIcon }}
      platformBadge={{ class: platformClass, label: formatValue(game.plataforma) }}
      tagBadges={heroBadges}
    />
    <GameDetailNav hasDlcs={dlcTotal > 0} isCompetitive={isCompetitive} />

    <section class="hero-analysis-grid" aria-label="Análisis de juego">
      <GameDetailHours
        slug={slug}
        metrics={valueMetrics}
        hoursChartPayload={hoursChartPayload}
        hoursChartPoints={hltbBars}
        hltbBreakdown={hltbBreakdown}
        period={{ startLabel: formatDate(game.fecha_inicio), endLabel: formatDate(game.fecha_fin), elapsedDays }}
        editValues={{ horas: valueMetrics.realHours, fecha_inicio: game.fecha_inicio, fecha_fin: game.fecha_fin }}
      />
      <GameDetailFinance
        slug={slug}
        metrics={valueMetrics}
        paidUnitPrice={paidUnitPrice}
        moneyChartPayload={moneyChartPayload}
        moneyChartPoints={moneyChartPoints}
        dlcChartPayload={dlcChartPayload}
        dlcChartPoints={dlcMarketPoints}
        hasDlcs={dlcTotal > 0}
        marketCards={marketCards}
        editValues={{
          precio_pagado: paidUnitPrice,
          unidades_compradas: valueMetrics.purchasedUnits,
          tiendas_compra: purchaseStores,
          plataforma: game.plataforma,
          gasto_microtransacciones: game.gasto_microtransacciones ?? null,
          tags: rawTags.map(normalizeGameTag),
        }}
      />
    </section>

    {isCompetitive && <GameDetailCompetitive slug={slug} peakRank={game.rango_maximo ?? null} />}
    <GameDetailStats
      slug={slug}
      metadataGroups={metadataGroups}
      editValues={{
        generos: genresList,
        tags: rawTags,
        modos: gameModes,
        launcher: game.launcher,
        plataforma: game.plataforma,
        tamano: game.tamano ?? null,
        lanzamiento: game.lanzamiento ?? null,
        steam_appid: game.steam_appid ?? null,
        hltb_match: game.hltb_match ?? null,
        dificultad: game.dificultad ?? null,
        logros_actual: game.logros?.actual ?? null,
        logros_total: game.logros?.total ?? null,
      }}
    />
    {dlcTotal > 0 && (
      <GameDetailDLCs
        slug={slug}
        dlcItems={dlcItems}
        dlcTotal={dlcTotal}
        formatDate={formatDate}
        formatValue={formatValue}
        formatCurrency={formatCurrency}
      />
    )}
    <GameDetailMetacritic slug={slug} critique={game.critica ?? null} legacyScore={legacyScore} includeCommunity={includeCommunity} />
    <GameDetailComments slug={slug} comentarios={formatValue(game.comentarios)} editValues={{ comentarios: game.comentarios ?? null }} />
  </main>
  <GameDetailChartsScript />
</BaseLayout>
