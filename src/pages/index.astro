---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmptyState from '../components/EmptyState.astro';
import CatalogFilters from '../components/CatalogFilters.astro';
import CatalogGameCard from '../components/CatalogGameCard.astro';
import GameCard from '../components/GameCard.astro';
import HomeCatalogHero from '../components/HomeCatalogHero.astro';
import sortIcon from '@tabler/icons/outline/arrow-down.svg?url';
import '../styles/catalog.css';
import '../styles/inventory.css';
import '../styles/cards.css';
import '../styles/card-tilt.css';
import '../styles/catalog-mobile.css';
import '../styles/brand-catalog.css';
import { toCatalogGame } from '../lib/catalog-game';
import { getStats, getUniqueValues, readGames } from '../lib/local-games';
import { getGameValueMetrics } from '../lib/game-finance';

const games = await readGames();
const catalogGames = games
  .map(toCatalogGame)
  .sort((a, b) => Number(b.horas ?? -1) - Number(a.horas ?? -1));
const initialCatalogGames = catalogGames.slice(0, 24);
const estados = getUniqueValues(games, 'estado');
const launchers = getUniqueValues(games, 'launcher');
const plataformas = getUniqueValues(games, 'plataforma');
const stats = getStats(games);

const totalLibraryValue = games.reduce((sum, game) => sum + getGameValueMetrics(game).recordedSpend, 0);
const totalAchievements = games.reduce((sum, game) => {
  const achievements = Number(game.logros?.actual ?? 0);
  return sum + (Number.isFinite(achievements) ? achievements : 0);
}, 0);
const formatMoney = (value: number) =>
  new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(value);
const formatNumber = (value: number) =>
  new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 }).format(value);
const initialView = Astro.url.searchParams.get('view') === 'table' ? 'table' : 'cards';
const tableColumns = [
  { key: 'titulo', label: 'Juego', direction: 'asc' },
  { key: 'estado', label: 'Estado', direction: 'asc' },
  { key: 'launcher', label: 'Launcher', direction: 'asc' },
  { key: 'plataforma', label: 'Plataforma', direction: 'asc' },
  { key: 'horas', label: 'Horas', direction: 'desc' },
  { key: 'precio', label: 'Pagado', direction: 'desc' },
  { key: 'lanzamiento', label: 'Lanzamiento', direction: 'desc' },
] as const;
---

<BaseLayout title='Catálogo — NooVDB' active='catalogo' pageClass='home-catalog'>
  <HomeCatalogHero totalHours={formatNumber(stats.horas)} totalSpend={formatMoney(totalLibraryValue)} totalAchievements={totalAchievements} />
      <!-- Filtros del catálogo -->
      <CatalogFilters
        estados={estados}
        launchers={launchers}
        plataformas={plataformas}
        totalGames={stats.total}
        initialView={initialView}
      />

      <!-- Grid de cards -->
      <section class='mock-catalog-results panel' id='cards-shell' hidden={initialView === 'table'}>
        <section class='cards cards-bento mock-cards-grid' id='cards'>
          {initialCatalogGames.map((game, index) => (
            <CatalogGameCard game={game} eager={index < 6} />
          ))}
        </section>
      </section>

      <!-- Vista tabla -->
      <section class='inventory-table-shell' id='table-shell' hidden={initialView !== 'table'}>
        <div class='inventory-table'>
          <div class='inventory-table-head' aria-label='Ordenar tabla por columna'>
            {tableColumns.map((column) => (
              <button
                class='inventory-sort-button'
                type='button'
                data-table-sort={column.key}
                data-default-direction={column.direction}
                aria-pressed='false'
                aria-label={`Ordenar por ${column.label}`}
              >
                <span>{column.label}</span>
                <img src={sortIcon} alt='' aria-hidden='true' />
              </button>
            ))}
          </div>
          <div class='inventory-table-body' id='table-body'></div>
        </div>
      </section>



    <!-- Templates y dialog -->
    <GameCard />
    <template id='catalog-empty-template'><EmptyState title='No encontramos ese juego' description='Prueba otra búsqueda o elimina los filtros activos.' action='Limpiar filtros' reset='catalog' /></template>



  <!-- Puente de datos: serializa la proyección del catálogo para catalog.ts -->
  <div id='__catalog-data' data-games={JSON.stringify(catalogGames)} hidden></div>

  <script>
    import { initCatalog } from '../scripts/catalog';
    import { initCardTilt } from '../scripts/card-tilt';
    const dataEl = document.getElementById('__catalog-data');
    const games = JSON.parse(dataEl?.dataset.games ?? '[]');
    initCatalog(games);
    initCardTilt(document.getElementById('cards'));
  </script>
</BaseLayout>
