---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetricCard from '../../components/MetricCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import PageHeader from '../../components/PageHeader.astro';
import TablerIcon from '../../components/TablerIcon.astro';
import '../../styles/criterio.css';
import '../../styles/brand-reviews.css';
import arrowRightIcon from '@tabler/icons/outline/arrow-right.svg?url';
import checksIcon from '@tabler/icons/outline/checks.svg?url';
import chevronDownIcon from '@tabler/icons/outline/chevron-down.svg?url';
import divideIcon from '@tabler/icons/outline/divide.svg?url';
import equalIcon from '@tabler/icons/outline/equal.svg?url';
import starIcon from '@tabler/icons/outline/star.svg?url';
import usersIcon from '@tabler/icons/outline/users-group.svg?url';
import { buildGameCoverUrl } from '../../lib/game-cover-url';
import { readGames, slugifyGameTitle } from '../../lib/local-games';
import { isCompletedStatus } from '../../lib/game-status';
import { calculatePersonalScore, isCommunityCriterionApplicable, REVIEW_CRITERIA } from '../../lib/game-reviews';

const games = await readGames();
const baseCriterionCount = REVIEW_CRITERIA.filter((criterion) => criterion.key !== 'comunidad').length;


const ratedGames = games
  .flatMap((game) => {
    const rating = calculatePersonalScore(game.critica, isCommunityCriterionApplicable(game));
    return rating !== null
      ? [{ game, rating }]
      : [];
  })
  .sort((a, b) => b.rating - a.rating || a.game.titulo.localeCompare(b.game.titulo, 'es'));

const completedGames = games.filter((game) => isCompletedStatus(game.estado));
const pendingRatings = completedGames
  .filter((game) => calculatePersonalScore(game.critica, isCommunityCriterionApplicable(game)) === null)
  .sort((a, b) => a.titulo.localeCompare(b.titulo, 'es'));
const nextPendingRating = pendingRatings[0] ?? null;
const remainingPendingRatings = pendingRatings.slice(1);

const averageRating = ratedGames.length > 0
  ? ratedGames.reduce((sum, item) => sum + item.rating, 0) / ratedGames.length
  : null;
const coverage = completedGames.length > 0
  ? Math.round((ratedGames.length / completedGames.length) * 100)
  : 0;

const formatRating = (rating: number) =>
  new Intl.NumberFormat('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 }).format(rating);
---

<BaseLayout title='Metacrítica — NooVDB' active='criticas' pageClass='criterion-main'>
      <PageHeader title="Metacrítica" eyebrow="Tu propia escala">
        <div slot='aside' class='criterion-hero-score' role='group' aria-label={`Nota media ${averageRating === null ? 'sin datos' : `${formatRating(averageRating)} sobre 10`}`}>
          <span>Media personal</span>
          <strong>{averageRating === null ? '—' : formatRating(averageRating)}</strong>
          <small>/ 10</small>
        </div>
      </PageHeader>

      <section class='metric-grid' aria-label='Resumen de puntuaciones'>
        <MetricCard label='Juegos puntuados' value={ratedGames.length} context='Con una nota propia' icon={starIcon} primary />
        <MetricCard label='Cobertura' value={`${coverage}%`} context='De los juegos terminados' icon={checksIcon} />
        <MetricCard label='Pendientes' value={pendingRatings.length} context='Terminados sin valorar' />
      </section>

      <section class='panel criterion-section criterion-methodology'>
        <div class='criterion-section-head'>
          <div>
            <span class='section-eyebrow'>Sistema de puntuación</span>
            <h2>Qué significa cada nota</h2>
          </div>
          <span class='criterion-count'>Resultado final sobre 10</span>
        </div>

        <div class='criterion-formula' role='group' aria-label={`${baseCriterionCount} criterios base, puntos obtenidos entre puntos máximos, comunidad con peso cero coma cinco cuando aplica, mención honorífica con bonus de hasta cero coma tres y resultado máximo de diez`}>
          <span><TablerIcon src={checksIcon} /> {baseCriterionCount} criterios base</span>
          <span><TablerIcon src={divideIcon} /> Puntos obtenidos / máximos</span>
          <span><TablerIcon src={usersIcon} /> Comunidad ×0,5 cuando aplica</span>
          <span><TablerIcon src={starIcon} /> Mención: hasta +0,3</span>
          <span><TablerIcon src={equalIcon} /> Máximo 10</span>
        </div>

        <div class='criterion-methodology-grid'>
          {REVIEW_CRITERIA.map((criterion, index) => (
            <details class:list={['criterion-method-card', criterion.key === 'comunidad' && 'criterion-method-card-conditional']} open={index === 0}>
              <summary class='criterion-method-card-head'>
                <h3>{criterion.label}</h3>
                <div>
                  <span>{criterion.min}–{criterion.max}</span>
                  <span>{criterion.weight === 1 ? `${criterion.max} ${criterion.max === 1 ? 'punto máximo' : 'puntos máximos'}` : `Peso ×${String(criterion.weight).replace('.', ',')}`}</span>
                  {criterion.key === 'comunidad' && <span>Solo comunidad pública / competitivo</span>}
                </div>
                <TablerIcon src={chevronDownIcon} class='criterion-method-chevron' />
              </summary>
              <div class='criterion-method-body'>
                <span class='sr-only'>{criterion.measures}</span>
                {criterion.scale ? (
                  <ol class='criterion-scale-list'>
                    {Object.entries(criterion.scale).map(([score, description]) => (
                      <li>
                        <strong>{score}</strong>
                        <span>{description}</span>
                      </li>
                    ))}
                  </ol>
                ) : null}
              </div>
            </details>
          ))}
        </div>

        <details class='criterion-honorary-method'>
          <summary>
            <div>
              <span class='section-eyebrow'>Bonus final</span>
              <h3>Mención honorífica · disfrute personal</h3>
            </div>
            <div class='criterion-formula'>
              <span>+0,1 por nivel</span>
              <span>Máximo 10</span>
            </div>
            <TablerIcon src={chevronDownIcon} class='criterion-method-chevron' />
          </summary>
          <ol class='criterion-scale-list'>
            <li><strong>0</strong><span>No especialmente · +0.</span></li>
            <li><strong>1</strong><span>Me gustó · +0,1.</span></li>
            <li><strong>2</strong><span>Lo disfruté mucho · +0,2.</span></li>
            <li><strong>3</strong><span>Me encantó · +0,3.</span></li>
          </ol>
        </details>
      </section>

      <section class='panel criterion-section'>
        <div class='criterion-section-head'>
          <div>
            <span class='section-eyebrow'>Reseñas</span>
            <h2>Tu clasificación</h2>
          </div>
          <span class='criterion-count'>{ratedGames.length} puntuadas</span>
        </div>

        {ratedGames.length > 0 ? (
          <div class='criterion-review-grid'>
            {ratedGames.map(({ game, rating }, index) => (
              <a class='criterion-review-card' href={`/games/${slugifyGameTitle(game.titulo)}/`}>
                <div class='criterion-review-cover'>
                  <img
                    src={buildGameCoverUrl(game)}
                    alt=''
                    aria-hidden='true'
                    loading={index < 4 ? 'eager' : 'lazy'}
                    decoding='async'
                  />
                </div>
                <div class='criterion-review-copy'>
                  <span class='criterion-review-state'>{game.estado ?? 'Sin estado'}</span>
                  <h3>{game.titulo}</h3>
                  <p>{game.comentarios || 'Sin reseña escrita todavía.'}</p>
                  <span class='criterion-review-action'>Abrir ficha y ver el desglose</span>
                </div>
                <div class='criterion-review-score'>
                  <strong>{formatRating(rating)}</strong>
                  <span>/ 10</span>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <EmptyState title='Tu primera crítica' description='Abre una ficha y completa sus criterios de valoración.' action='Elegir un juego' href='/' icon={starIcon} />
        )}
      </section>

      <section class='panel criterion-section'>
        <div class='criterion-section-head'>
          <div>
            <span class='section-eyebrow'>Cola de valoración</span>
            <h2>Terminados sin nota</h2>
          </div>
          <span class='criterion-count'>{pendingRatings.length} pendientes</span>
        </div>

        {nextPendingRating ? (
          <div class='criterion-pending-stack'>
            <a class='criterion-next-review' href={`/games/${slugifyGameTitle(nextPendingRating.titulo)}/#metacritica`}>
              <span><small>Siguiente</small><strong>{nextPendingRating.titulo}</strong></span>
              <span>Valorar <TablerIcon src={arrowRightIcon} /></span>
            </a>
            {remainingPendingRatings.length > 0 && (
              <details class='criterion-pending-more'>
                <summary>
                  <span>Ver los otros {remainingPendingRatings.length}</span>
                  <TablerIcon src={chevronDownIcon} />
                </summary>
                <div class='criterion-pending-list'>
                  {remainingPendingRatings.map((game) => (
                    <a href={`/games/${slugifyGameTitle(game.titulo)}/#metacritica`}>
                      <span>{game.titulo}</span>
                      <small>Valorar</small>
                    </a>
                  ))}
                </div>
              </details>
            )}
          </div>
        ) : (
          <div class='criterion-empty'>
            <strong>Todos tus juegos terminados tienen nota.</strong>
          </div>
        )}
      </section>

</BaseLayout>
