---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MetricCard from '../../components/MetricCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import PageHeader from '../../components/PageHeader.astro';
import TablerIcon from '../../components/TablerIcon.astro';
import '../../styles/data-pending.css';
import '../../styles/brand-pending.css';
import arrowRightIcon from '@tabler/icons/outline/arrow-right.svg?url';
import checkIcon from '@tabler/icons/outline/check.svg?url';
import databaseIcon from '@tabler/icons/outline/database-exclamation.svg?url';
import searchIcon from '@tabler/icons/outline/search.svg?url';
import { getDataCompleteness } from '../../lib/game-data-completeness';
import { readGames } from '../../lib/local-games';

const games = await readGames();
const report = getDataCompleteness(games);
const categoryLabels = {
  copia: 'Mi copia',
  actividad: 'Actividad',
  compra: 'Compra',
  valoracion: 'Valoración',
} as const;
const editorAnchors = {
  status: 'game-header',
  technical: 'technical',
  hours: 'hours',
  finance: 'finance',
  review: 'metacritica',
} as const;
---

<BaseLayout title='Pendientes — NooVDB' active='datos' pageClass='data-pending-page'>
      <PageHeader title="Pendientes" eyebrow="Calidad de tu biblioteca" description="Localiza fichas incompletas y abre directamente el editor que necesitas.">
        <div slot='aside' class='data-completion-ring' style={`--completion:${report.completionPct * 3.6}deg`} aria-label={`${report.completionPct}% de datos completados`}>
          <div><strong>{report.completionPct}%</strong><span>completo</span></div>
        </div>
      </PageHeader>

      <section class='metric-grid data-summary' aria-label='Resumen de datos pendientes'>
        <MetricCard label='Fichas por completar' value={report.incompleteGames} context={`de ${report.totalGames} juegos`} icon={databaseIcon} primary />
        <MetricCard label='Campos pendientes' value={report.totalMissing} context='Ordenados por prioridad' />
        <MetricCard label='Fichas completas' value={report.totalGames - report.incompleteGames} context='Sin datos esenciales pendientes' icon={checkIcon} />
      </section>

      <section class='panel data-filter-bar' aria-label='Filtrar datos pendientes'>
        <label class='data-search-field'>
          <TablerIcon src={searchIcon} />
          <span class='sr-only'>Buscar datos pendientes por juego</span>
          <input type='search' placeholder='Buscar un juego…' autocomplete='off' data-pending-search />
        </label>
        <label class='data-category-field'>
          <span>Mostrar</span>
          <select data-pending-category>
            <option value=''>Todos los datos</option>
            <option value='copia'>Mi copia</option>
            <option value='actividad'>Actividad</option>
            <option value='compra'>Compra</option>
            <option value='valoracion'>Valoración</option>
          </select>
        </label>
        <strong data-pending-count aria-live='polite'>{report.incompleteGames} juegos</strong>
      </section>

      {report.games.length > 0 ? (
        <section class='data-pending-list' data-pending-root>
          {report.games.map((game) => {
            const categories = [...new Set(game.missing.map((gap) => gap.category))];
            const firstEditor = game.missing[0]?.editor ?? 'technical';
            return (
              <article
                class='panel data-game-card'
                data-pending-card
                data-title={game.titulo}
                data-categories={categories.join(' ')}
              >
                <a class='data-game-cover' href={`/games/${game.slug}/`} aria-label={`Ver ficha de ${game.titulo}`}>
                  <img src={game.coverUrl} alt='' loading='lazy' decoding='async' />
                </a>
                <div class='data-game-content'>
                  <div class='data-game-head'>
                    <div>
                      <span class='data-game-status'>{game.estado}</span>
                      <h2><a href={`/games/${game.slug}/`}>{game.titulo}</a></h2>
                    </div>
                    <div class='data-game-score'>
                      <strong>{game.completionPct}%</strong>
                      <span>{game.completedFields}/{game.applicableFields} campos</span>
                    </div>
                  </div>
                  <div class='data-progress' aria-hidden='true'><span style={`width:${game.completionPct}%`}></span></div>
                  <div class='data-game-missing'>
                    {game.missing.map((gap) => (
                      <a
                        class={`data-gap data-gap-${gap.category}`}
                        href={`/games/${game.slug}/?edit=${gap.editor}#${editorAnchors[gap.editor]}`}
                        title={`Completar ${gap.label}`}
                      >
                        <span>{categoryLabels[gap.category]}</span>
                        {gap.label}
                      </a>
                    ))}
                  </div>
                </div>
                <a class='data-game-action' href={`/games/${game.slug}/?edit=${firstEditor}#${editorAnchors[firstEditor]}`}>
                  Completar ficha
                  <TablerIcon src={arrowRightIcon} />
                </a>
              </article>
            );
          })}
          <div class='data-filter-empty'><EmptyState title='Sin coincidencias' description='Prueba otro nombre o muestra todas las categorías.' action='Limpiar filtros' reset='pending' /></div>
        </section>
      ) : (
        <section class='panel data-all-complete'>
          <TablerIcon src={checkIcon} />
          <h2>La biblioteca está completa</h2>
          <p>No queda ningún dato esencial por rellenar.</p>
        </section>
      )}

      <aside class='data-scope-note'>
        <TablerIcon src={databaseIcon} />
        <p><strong>Qué se revisa:</strong> estado y datos de tu copia; según el estado del juego, también horas, fechas, precio pagado y valoración personal. Dificultad, logros, cromos y comentarios son opcionales.</p>
      </aside>


  <script>
    import { initDataPendingFilters } from '../../scripts/data-pending';
    initDataPendingFilters();
  </script>
</BaseLayout>
