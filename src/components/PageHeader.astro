---
interface Props { title: string; eyebrow?: string; description?: string; }
const { title, eyebrow, description } = Astro.props;
---
<header class="page-header">
  <div class="page-header-copy">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {description && <p>{description}</p>}
  </div>
  {Astro.slots.has('aside') && <div class="page-header-aside"><slot name="aside" /></div>}
  {Astro.slots.has('default') && <div class="page-header-meta"><slot /></div>}
</header>
