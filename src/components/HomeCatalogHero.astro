---
import PageHeader from './PageHeader.astro';
import TablerIcon from './TablerIcon.astro';
import hoursIcon from '@tabler/icons/outline/clock.svg?url';
import spendingIcon from '@tabler/icons/outline/wallet.svg?url';
import achievementsIcon from '@tabler/icons/outline/trophy.svg?url';
interface Props { totalHours: string; totalSpend: string; totalAchievements: number; }
const { totalHours, totalSpend, totalAchievements } = Astro.props;
const metrics = [
  { value: totalHours + ' h', label: 'Horas', icon: hoursIcon },
  { value: totalSpend, label: 'Gastado', icon: spendingIcon },
  { value: totalAchievements.toLocaleString('es-ES'), label: 'Logros', icon: achievementsIcon },
];
---
<PageHeader title="Catálogo" eyebrow="Personal Database">
  <dl class="home-hero-metrics" aria-label="Resumen de la biblioteca">
    {metrics.map(metric => <div><dt><TablerIcon src={metric.icon} /><span>{metric.label}</span></dt><dd>{metric.value}</dd></div>)}
  </dl>
</PageHeader>
