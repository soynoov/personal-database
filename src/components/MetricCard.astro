---
import TablerIcon from './TablerIcon.astro';
interface Props {
  label: string;
  value: number | string;
  context?: string;
  icon?: string;
  primary?: boolean;
  unit?: string;
}
const { label, value, context, icon, primary = false, unit } = Astro.props;
---
<article class:list={['metric-card', primary && 'metric-card-primary']}>
  <div class='metric-card-head'><span>{label}</span>{icon && <TablerIcon src={icon} />}</div>
  <strong>{typeof value === 'number' ? value.toLocaleString('es-ES') : value}{unit && <span class="metric-unit">{unit}</span>}</strong>
  {context && <small>{context}</small>}
</article>
