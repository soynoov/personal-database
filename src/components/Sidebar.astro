---
import { normalizeStatus } from '../lib/game-status';
import catalogIcon from '@tabler/icons/outline/device-gamepad-2.svg?url';
import rouletteIcon from '@tabler/icons/outline/dice-5.svg?url';
import statisticsIcon from '@tabler/icons/outline/chart-histogram.svg?url';
import dataPendingIcon from '@tabler/icons/outline/database-exclamation.svg?url';
import reviewsIcon from '@tabler/icons/outline/message-star.svg?url';
import githubIcon from '@tabler/icons/outline/brand-github.svg?url';
import closeIcon from '@tabler/icons/outline/x.svg?url';
import collapseIcon from '@tabler/icons/outline/chevrons-left.svg?url';
import TablerIcon from './TablerIcon.astro';
import { PUBLIC_GAME_TAGS } from '../lib/game-tags';
import { GAME_MODES } from '../lib/game-modes';

interface Props {
  orderedDrawerEstados: string[];
  plataformas: string[];
  launchers: string[];
  active?: 'catalogo' | 'ruleta' | 'estadisticas' | 'datos' | 'criticas';
  compact?: boolean;
}

const { orderedDrawerEstados, plataformas, launchers, active = 'catalogo', compact = false } = Astro.props;

const mobileNavigation = [
  { key: 'catalogo', href: '/', label: 'Catálogo', icon: catalogIcon },
  { key: 'ruleta', href: '/ruleta/', label: 'Ruleta', icon: rouletteIcon },
  { key: 'estadisticas', href: '/estadisticas/', label: 'Estadísticas', icon: statisticsIcon },
  { key: 'criticas', href: '/criticas/', label: 'Metacrítica', icon: reviewsIcon },
  { key: 'datos', href: '/datos-pendientes/', label: 'Pendientes', icon: dataPendingIcon },
] as const;

const estadoColor = (estado: string): string => {
  const n = normalizeStatus(estado);
  if (n === 'jugando') return '#6ee76c';
  if (n === 'terminado' || n === 'completado') return '#67b1ff';
  if (n === 'pendiente') return '#f5c518';
  if (n === 'wishlist') return '#5ad0ff';
  if (n === 'pausado') return '#f5a818';
  if (n === 'abandonado' || n === 'retirado') return '#ff7055';
  if (n === 'recurrente') return '#c9a0ff';
  return '#8b9ab5';
};
---

<!-- Mobile Drawer Overlay -->
<div class='mobile-drawer-overlay' id='mobile-drawer-overlay' aria-hidden='true'></div>

<!-- Mobile Drawer -->
<nav
  class='mobile-drawer'
  id='mobile-drawer'
  aria-label='Menú lateral'
  aria-hidden='true'
>
  <div class='mobile-drawer-header'>
    <div class='mobile-drawer-brand'>
      <div class='desktop-sidebar-brandmark mobile-brandmark' aria-hidden='true'>
        <img src='/logo-mark.png' alt='' loading='eager' decoding='async' />
      </div>
      <div class='mobile-brand-copy'>
        <span>NooVDB</span>
        <span>Personal Database</span>
      </div>
    </div>
    <button class='mobile-drawer-close' id='mobile-drawer-close' type='button' aria-label='Cerrar menú'>
      <TablerIcon src={closeIcon} />
    </button>
  </div>

  <div class='mobile-drawer-body'>
    <div class='mobile-drawer-nav'>
      {mobileNavigation.map((item) => (
        <a
          class:list={['mobile-drawer-nav-item', active === item.key && 'is-active']}
          aria-current={active === item.key ? 'page' : undefined}
          href={item.href}
        >
          <TablerIcon src={item.icon} />
          <span>{item.label}</span>
        </a>
      ))}
    </div>

    <div class:list={['mobile-drawer-filters', active !== 'catalogo' && 'is-hidden']}>
    <div class='mobile-drawer-section'>
      <span class='mobile-drawer-section-label'>Estado</span>
      <button class='mobile-drawer-item' data-drawer-filter='estado' data-value='' type='button'>
        <span class='mobile-drawer-dot' style='background:#5a6a80'></span>
        <span>Todos</span>
      </button>
      {orderedDrawerEstados.map((estado) => (
        <button class='mobile-drawer-item' data-drawer-filter='estado' data-value={estado} type='button'>
          <span class='mobile-drawer-dot' style={`background:${estadoColor(estado)}`} />
          <span>{estado}</span>
        </button>
      ))}
    </div>

    {plataformas.length > 0 && (
      <div class='mobile-drawer-section'>
        <span class='mobile-drawer-section-label'>Plataforma</span>
        <button class='mobile-drawer-item' data-drawer-filter='plataforma' data-value='' type='button'>
          <span>Todas</span>
        </button>
        {plataformas.map((p) => (
          <button class='mobile-drawer-item' data-drawer-filter='plataforma' data-value={p} type='button'>
            <span>{p}</span>
          </button>
        ))}
      </div>
    )}

    {launchers.length > 0 && (
      <div class='mobile-drawer-section'>
        <span class='mobile-drawer-section-label'>Launcher</span>
        <button class='mobile-drawer-item' data-drawer-filter='launcher' data-value='' type='button'>
          <span>Todos</span>
        </button>
        {launchers.map((l) => (
          <button class='mobile-drawer-item' data-drawer-filter='launcher' data-value={l} type='button'>
            <span>{l}</span>
          </button>
        ))}
      </div>
    )}

    <div class='mobile-drawer-section mobile-drawer-section-compact'>
      <span class='mobile-drawer-section-label'>Etiqueta</span>
      <button class='mobile-drawer-item' data-drawer-filter='tag' data-value='' type='button'>
        <span>Todas</span>
      </button>
      {PUBLIC_GAME_TAGS.map((tag) => (
        <button class='mobile-drawer-item' data-drawer-filter='tag' data-value={tag.value} type='button'>
          <span>{tag.label}</span>
        </button>
      ))}
    </div>

    <div class='mobile-drawer-section mobile-drawer-section-compact'>
      <span class='mobile-drawer-section-label'>Modo de juego</span>
      <button class='mobile-drawer-item' data-drawer-filter='modo' data-value='' type='button'>
        <span>Todos</span>
      </button>
      {GAME_MODES.map((mode) => (
        <button class='mobile-drawer-item' data-drawer-filter='modo' data-value={mode.value} type='button'>
          <span>{mode.label}</span>
        </button>
      ))}
    </div>

    <div class='mobile-drawer-section mobile-drawer-section-compact'>
      <span class='mobile-drawer-section-label'>Precio pagado</span>
      <button class='mobile-drawer-item' data-drawer-filter='precio' data-value='' type='button'>
        <span>Todos</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='precio' data-value='free' type='button'>
        <span>Free to play</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='precio' data-value='cheap' type='button'>
        <span>Hasta 10 EUR</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='precio' data-value='mid' type='button'>
        <span>De 10 a 30 EUR</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='precio' data-value='high' type='button'>
        <span>Más de 30 EUR</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='precio' data-value='unknown' type='button'>
        <span>Sin dato</span>
      </button>
    </div>

    <div class='mobile-drawer-section mobile-drawer-section-compact'>
      <span class='mobile-drawer-section-label'>Rentabilidad</span>
      <button class='mobile-drawer-item' data-drawer-filter='rentabilidad' data-value='' type='button'>
        <span>Todas</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='rentabilidad' data-value='amortized' type='button'>
        <span>Amortizados</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='rentabilidad' data-value='unamortized' type='button'>
        <span>No amortizados</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='rentabilidad' data-value='incomplete' type='button'>
        <span>Datos incompletos</span>
      </button>
    </div>

    <div class='mobile-drawer-section'>
      <span class='mobile-drawer-section-label'>Ordenar</span>
      <button class='mobile-drawer-item' data-drawer-filter='sort' data-value='titulo-asc' type='button'>
        <span>A → Z</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='sort' data-value='horas-desc' type='button'>
        <span>Más horas</span>
      </button>
      <button class='mobile-drawer-item' data-drawer-filter='sort' data-value='lanzamiento-desc' type='button'>
        <span>Más reciente</span>
      </button>
    </div>
    </div>
  </div>
</nav>

<!-- Desktop Sidebar -->
<aside class:list={['desktop-sidebar', 'panel', compact && 'is-compact']} aria-label='Navegación principal'>
  <div class='desktop-sidebar-brand'>
    <div class='desktop-sidebar-brandmark' aria-hidden='true'>
      <img src='/logo-mark.png' alt='' loading='eager' decoding='async' />
    </div>
    <div class='desktop-sidebar-copy'>
      <div class='desktop-sidebar-title'>NooVDB</div>
      <div class='desktop-sidebar-subtitle'>Personal Database</div>
    </div>
  </div>

  <nav class='desktop-sidebar-nav'>
    <a class:list={['desktop-nav-item', active === 'catalogo' && 'is-active']} aria-current={active === 'catalogo' ? 'page' : undefined} href='/'>
      <span class='desktop-nav-icon' aria-hidden='true'>
        <TablerIcon src={catalogIcon} />
      </span>
      <span class='desktop-nav-label'>Catálogo</span>
    </a>
    <a class:list={['desktop-nav-item', active === 'ruleta' && 'is-active']} aria-current={active === 'ruleta' ? 'page' : undefined} href='/ruleta/'>
      <span class='desktop-nav-icon' aria-hidden='true'>
        <TablerIcon src={rouletteIcon} />
      </span>
      <span class='desktop-nav-label'>Ruleta</span>
    </a>
    <a class:list={['desktop-nav-item', active === 'estadisticas' && 'is-active']} aria-current={active === 'estadisticas' ? 'page' : undefined} href='/estadisticas/'>
      <span class='desktop-nav-icon' aria-hidden='true'>
        <TablerIcon src={statisticsIcon} />
      </span>
      <span class='desktop-nav-label'>Estadísticas</span>
    </a>
    <a class:list={['desktop-nav-item', active === 'criticas' && 'is-active']} aria-current={active === 'criticas' ? 'page' : undefined} href='/criticas/'>
      <span class='desktop-nav-icon' aria-hidden='true'>
        <TablerIcon src={reviewsIcon} />
      </span>
      <span class='desktop-nav-label'>Metacrítica</span>
    </a>
    <a class:list={['desktop-nav-item', active === 'datos' && 'is-active']} aria-current={active === 'datos' ? 'page' : undefined} href='/datos-pendientes/'>
      <span class='desktop-nav-icon' aria-hidden='true'>
        <TablerIcon src={dataPendingIcon} />
      </span>
      <span class='desktop-nav-label'>Pendientes</span>
    </a>
  </nav>

  <a
    class='desktop-sidebar-link desktop-sidebar-link-top'
    href='https://github.com/soynoov/personal-database'
    target='_blank'
    rel='noreferrer'
  >
    <TablerIcon src={githubIcon} />
    <span>GitHub</span>
  </a>

  <button class='desktop-sidebar-collapse' type='button' aria-label='Contraer sidebar' aria-expanded='true' data-sidebar-collapse>
    <TablerIcon src={collapseIcon} />
  </button>
</aside>
