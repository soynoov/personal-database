---
import TablerIcon from './TablerIcon.astro';
import catalogIcon from '@tabler/icons/outline/device-gamepad-2.svg?url';
import rouletteIcon from '@tabler/icons/outline/dice-5.svg?url';
import statisticsIcon from '@tabler/icons/outline/chart-histogram.svg?url';
import dataPendingIcon from '@tabler/icons/outline/database-exclamation.svg?url';
import reviewsIcon from '@tabler/icons/outline/message-star.svg?url';
import githubIcon from '@tabler/icons/outline/brand-github.svg?url';
import closeIcon from '@tabler/icons/outline/x.svg?url';
interface Props { active?: 'catalogo' | 'ruleta' | 'estadisticas' | 'datos' | 'criticas'; }
const { active = 'catalogo' } = Astro.props;
const navigation = [
  { key: 'catalogo', href: '/', label: 'Catálogo', mobile: 'Juegos', icon: catalogIcon },
  { key: 'ruleta', href: '/ruleta/', label: 'Ruleta', mobile: 'Ruleta', icon: rouletteIcon },
  { key: 'estadisticas', href: '/estadisticas/', label: 'Estadísticas', mobile: 'Estadísticas', icon: statisticsIcon },
  { key: 'criticas', href: '/criticas/', label: 'Metacrítica', mobile: 'Metacrítica', icon: reviewsIcon },
  { key: 'datos', href: '/datos-pendientes/', label: 'Pendientes', mobile: 'Pendientes', icon: dataPendingIcon },
];
---
<aside class="desktop-sidebar" id="desktop-navigation" aria-label="Navegación principal">
  <a class="app-brand-lockup" href="/" aria-label="NooVDB, catálogo"><img src="/favicon.png" alt="" width="32" height="32" hidden /><strong>NOOVDB</strong><span>Personal Database</span></a>
  <nav class="desktop-sidebar-nav">
    {navigation.map(item => (
      <a class:list={['desktop-nav-item', active === item.key && 'is-active']} href={item.href} aria-current={active === item.key ? 'page' : undefined} title={item.label} aria-label={item.label}>
        <TablerIcon src={item.icon} /><span>{item.label}</span>
      </a>
    ))}
  </nav>
  <a class="desktop-sidebar-link" href="https://github.com/soynoov/personal-database" target="_blank" rel="noreferrer" aria-label="GitHub (abre en otra pestaña)"><TablerIcon src={githubIcon} /><span>GitHub</span></a>
</aside>
<dialog class="app-navigation-menu" id="app-navigation-menu" aria-labelledby="app-menu-title">
  <div class="app-menu-head"><strong id="app-menu-title">NOOVDB</strong><button class="app-icon-button" id="app-menu-close" type="button" aria-label="Cerrar navegación"><TablerIcon src={closeIcon} /></button></div>
  <nav aria-label="Secciones">
    {navigation.map(item => <a class:list={['desktop-nav-item', active === item.key && 'is-active']} href={item.href} aria-current={active === item.key ? 'page' : undefined}><TablerIcon src={item.icon} /><span>{item.label}</span></a>)}
    <a class="desktop-nav-item" href="https://github.com/soynoov/personal-database" target="_blank" rel="noreferrer"><TablerIcon src={githubIcon} /><span>GitHub</span></a>
  </nav>
</dialog>
<nav class="mobile-bottom-nav" aria-label="Navegación principal">
  {navigation.map(item => <a class:list={['mobile-bottom-nav-item', active === item.key && 'is-active']} aria-current={active === item.key ? 'page' : undefined} href={item.href}><TablerIcon src={item.icon} /><span>{item.mobile}</span></a>)}
</nav>
