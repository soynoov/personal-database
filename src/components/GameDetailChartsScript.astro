<script>
  import {
    Chart,
    Filler,
    Tooltip,
    CategoryScale,
    LinearScale,
    LineController,
    LineElement,
    PointElement,
    BarController,
    BarElement,
  } from 'chart.js';

  Chart.register(
    Filler,
    Tooltip,
    CategoryScale,
    LinearScale,
    LineController,
    LineElement,
    PointElement,
    BarController,
    BarElement,
  );

  const charts = new Map<string, Chart>();
  const numberFormatter = new Intl.NumberFormat('es-ES', { maximumFractionDigits: 2 });

  const formatHoursDuration = (value: number) => {
    const totalMinutes = Math.max(0, Math.round(value * 60));
    const hours = Math.floor(totalMinutes / 60);
    const minutes = totalMinutes % 60;
    if (hours === 0) return `${minutes} min`;
    if (minutes === 0) return `${hours} h`;
    return `${hours} h ${minutes} min`;
  };

  const formatMetricValue = (metric: string, value: number) => (
    metric === 'currency'
      ? `${numberFormatter.format(value)} €`
      : formatHoursDuration(value)
  );

  const formatAxisValue = (metric: string, value: number) => (
    metric === 'currency'
      ? `${numberFormatter.format(value)} €`
      : `${numberFormatter.format(value)} h`
  );

  const hexToRgba = (hex: string, alpha: number) => {
    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
    if (!result) return `rgba(150, 145, 160, ${alpha})`;
    return `rgba(${parseInt(result[1], 16)}, ${parseInt(result[2], 16)}, ${parseInt(result[3], 16)}, ${alpha})`;
  };

  const buildGradient = (
    ctx: CanvasRenderingContext2D,
    area: { top: number; bottom: number },
    topColor: string,
    bottomColor: string,
  ) => {
    const gradient = ctx.createLinearGradient(0, area.top, 0, area.bottom);
    gradient.addColorStop(0, topColor);
    gradient.addColorStop(1, bottomColor);
    return gradient;
  };

  const wrapLabel = (label: string) => {
    if (label === 'Historia + extras') return ['Historia +', 'extras'];
    if (label === 'Mín. histórico') return ['Mín.', 'histórico'];
    return label;
  };

  const readChartPayload = (canvasId: string) => {
    const canvas = document.getElementById(canvasId);
    if (!(canvas instanceof HTMLCanvasElement)) return null;
    try {
      return { canvas, payload: JSON.parse(canvas.dataset.chart ?? 'null') };
    } catch {
      return null;
    }
  };

  const renderComparisonBars = (
    canvasId: string,
    expectedType: string,
    payloadOverride: Record<string, unknown> | null = null,
  ) => {
    const chartData = readChartPayload(canvasId);
    if (!chartData) return;

    const { canvas } = chartData;
    const payload = payloadOverride ?? chartData.payload;
    if (payload?.type !== expectedType) return;

    const sourcePoints = Array.isArray(payload.points) ? payload.points : [];
    const points = sourcePoints
      .map((point: Record<string, unknown>) => ({
        label: String(point.label ?? ''),
        value: Number(point.value),
        color: String(point.color ?? '#9387a4'),
      }))
      .filter((point: { label: string; value: number; color: string }) => point.label && Number.isFinite(point.value));
    if (points.length < 2) return;

    charts.get(canvasId)?.destroy();
    const values = points.map((point: { value: number }) => point.value);
    const colors = points.map((point: { color: string }) => point.color);
    const metric = String(payload.metric ?? 'hours');
    const referenceLine = payload.referenceLine && typeof payload.referenceLine === 'object'
      ? payload.referenceLine as { value?: unknown; color?: unknown }
      : null;
    const referenceValue = referenceLine === null ? null : Number(referenceLine.value);
    const referenceColor = referenceLine === null ? '#a98bd0' : String(referenceLine.color ?? '#a98bd0');
    const referenceLinePlugin = {
      id: `reference-line-${canvasId}`,
      afterDatasetsDraw(chartInstance: Chart) {
        if (referenceValue === null || !Number.isFinite(referenceValue)) return;
        const { ctx, chartArea, scales } = chartInstance;
        const y = scales.y?.getPixelForValue(referenceValue);
        if (!chartArea || y === undefined) return;

        ctx.save();
        ctx.strokeStyle = referenceColor;
        ctx.lineWidth = 1;
        ctx.globalAlpha = 0.9;
        ctx.beginPath();
        ctx.moveTo(chartArea.left, y);
        ctx.lineTo(chartArea.right, y);
        ctx.stroke();
        ctx.restore();
      },
    };

    const labels = points.map((point: { label: string; value: number }) => {
      const wrappedLabel = wrapLabel(point.label);
      if (expectedType !== 'hours-comparison') return wrappedLabel;
      const labelLines = Array.isArray(wrappedLabel) ? wrappedLabel : [wrappedLabel];
      return [...labelLines, formatMetricValue(metric, point.value)];
    });
    const chart = new Chart(canvas, {
      type: 'bar',
      plugins: referenceValue === null ? [] : [referenceLinePlugin],
      data: {
        labels,
        datasets: [{
          label: String(payload.seriesLabel ?? ''),
          data: values,
          backgroundColor: colors.map((color: string) => hexToRgba(color, 0.3)),
          hoverBackgroundColor: colors.map((color: string) => hexToRgba(color, 0.4)),
          borderColor: colors,
          borderWidth: 1.2,
          borderRadius: 8,
          borderSkipped: false,
          barPercentage: 0.62,
          categoryPercentage: 0.78,
          maxBarThickness: 82,
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 420, easing: 'easeOutQuart' },
        interaction: { intersect: false, mode: 'index' },
        layout: { padding: { top: 8 } },
        plugins: {
          legend: { display: false },
          tooltip: {
            displayColors: false,
            backgroundColor: 'rgba(12, 12, 18, 0.96)',
            borderColor: 'rgba(204, 181, 235, 0.18)',
            borderWidth: 1,
            padding: 11,
            cornerRadius: 9,
            titleColor: '#f7f1ee',
            bodyColor: '#d8cfdf',
            callbacks: {
              title(items) {
                return items.length ? points[items[0].dataIndex]?.label ?? '' : '';
              },
              label(context) {
                return formatMetricValue(metric, Number(context.parsed.y));
              },
            },
          },
        },
        scales: {
          x: {
            border: { display: false },
            grid: { display: false },
            ticks: {
              color: 'rgba(224, 216, 231, 0.67)',
              autoSkip: false,
              font: (context) => ({
                size: context.chart.width < 520 ? 9 : 11,
                weight: 600,
                lineHeight: context.chart.width < 520 ? 1.35 : 1.55,
              }),
              maxRotation: 0,
              minRotation: 0,
            },
          },
          y: {
            beginAtZero: true,
            suggestedMax: Math.max(...values, 1) * 1.12,
            border: { display: false },
            grid: {
              color: 'rgba(181, 169, 194, 0.11)',
              drawTicks: false,
              borderDash: [3, 4],
            },
            ticks: {
              color: 'rgba(218, 210, 225, 0.5)',
              padding: 10,
              maxTicksLimit: 5,
              font: { size: 10 },
              callback: (value) => formatAxisValue(metric, Number(value)),
            },
          },
        },
      },
    });

    charts.set(canvasId, chart);
  };

  const renderMarketLineChart = (
    canvasId: string,
    palette: { stroke: string; fillTop: string; fillBottom: string; fillFallback: string },
  ) => {
    const chartData = readChartPayload(canvasId);
    if (!chartData) return;

    const { canvas, payload } = chartData;
    if (payload?.type !== 'market-comparison') return;
    const points = Array.isArray(payload.points)
      ? payload.points
        .map((point: Record<string, unknown>) => ({
          label: String(point.label ?? ''),
          value: Number(point.value),
        }))
        .filter((point: { label: string; value: number }) => point.label && Number.isFinite(point.value))
      : [];
    if (points.length < 2) return;

    charts.get(canvasId)?.destroy();
    const metric = String(payload.metric ?? 'currency');
    const chart = new Chart(canvas, {
      type: 'line',
      data: {
        labels: points.map((point: { label: string }) => wrapLabel(point.label)),
        datasets: [{
          label: String(payload.seriesLabel ?? ''),
          data: points.map((point: { value: number }) => point.value),
          fill: true,
          tension: 0.34,
          borderWidth: 2,
          borderColor: palette.stroke,
          pointRadius: 4,
          pointHoverRadius: 6,
          pointBackgroundColor: palette.stroke,
          pointBorderColor: 'rgba(12, 12, 18, 0.84)',
          pointBorderWidth: 2,
          backgroundColor(context) {
            const { ctx, chartArea } = context.chart;
            if (!chartArea) return palette.fillFallback;
            return buildGradient(ctx, chartArea, palette.fillTop, palette.fillBottom);
          },
        }],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: { duration: 420, easing: 'easeOutQuart' },
        interaction: { intersect: false, mode: 'index' },
        layout: { padding: { top: 8 } },
        plugins: {
          legend: { display: false },
          tooltip: {
            displayColors: false,
            backgroundColor: 'rgba(12, 12, 18, 0.96)',
            borderColor: 'rgba(204, 181, 235, 0.18)',
            borderWidth: 1,
            padding: 11,
            cornerRadius: 9,
            titleColor: '#f7f1ee',
            bodyColor: '#d8cfdf',
            callbacks: {
              title(items) {
                return items.length ? points[items[0].dataIndex]?.label ?? '' : '';
              },
              label(context) {
                return formatMetricValue(metric, Number(context.parsed.y));
              },
            },
          },
        },
        scales: {
          x: {
            border: { display: false },
            grid: { display: false },
            ticks: {
              color: 'rgba(224, 216, 231, 0.67)',
              font: { size: 11, weight: 600 },
              maxRotation: 0,
              minRotation: 0,
            },
          },
          y: {
            border: { display: false },
            grid: { color: 'rgba(181, 169, 194, 0.11)', drawTicks: false },
            ticks: {
              color: 'rgba(218, 210, 225, 0.5)',
              padding: 10,
              maxTicksLimit: 5,
              font: { size: 10 },
              callback: (value) => formatAxisValue(metric, Number(value)),
            },
          },
        },
      },
    });

    charts.set(canvasId, chart);
  };

  const renderHoursChart = () => {
    const chartData = readChartPayload('hours-detail-chart');
    if (!chartData || chartData.payload?.type !== 'hours-vs-hltb') return;
    const { payload } = chartData;
    const points = Array.isArray(payload.hltbBars) ? [...payload.hltbBars] : [];
    if (payload.myHours !== null && payload.myHours !== undefined) {
      points.push({
        label: 'Mis horas',
        value: Number(payload.myHours),
        color: String(payload.myHoursColor ?? '#a98bd0'),
      });
    }
    renderComparisonBars('hours-detail-chart', 'hours-comparison', {
      type: 'hours-comparison',
      points,
      seriesLabel: 'Horas',
      metric: 'hours',
      referenceLine: payload.myHours === null || payload.myHours === undefined
        ? null
        : {
            value: Number(payload.myHours),
            color: String(payload.myHoursColor ?? '#a98bd0'),
          },
    });
  };

  const renderAllCharts = () => {
    renderHoursChart();
    renderMarketLineChart('money-detail-chart', {
      stroke: '#b792e5',
      fillTop: 'rgba(183, 146, 229, 0.25)',
      fillBottom: 'rgba(183, 146, 229, 0.02)',
      fillFallback: 'rgba(183, 146, 229, 0.14)',
    });
    renderMarketLineChart('dlc-finance-chart', {
      stroke: '#a895c4',
      fillTop: 'rgba(168, 149, 196, 0.22)',
      fillBottom: 'rgba(168, 149, 196, 0.02)',
      fillFallback: 'rgba(168, 149, 196, 0.12)',
    });
  };

  renderAllCharts();
  document.querySelectorAll<HTMLDetailsElement>('.value-secondary-details').forEach((details) => {
    details.addEventListener('toggle', () => {
      if (details.open) window.requestAnimationFrame(renderAllCharts);
    });
  });

  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(renderAllCharts, 120);
  });
</script>
