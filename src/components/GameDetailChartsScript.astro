<script>
  import { renderHoursComparison } from '../scripts/game-hours-chart';
  import { renderMarketComparison } from '../scripts/game-market-chart';
  const renderAllCharts = () => {
    renderHoursComparison();
    renderMarketComparison('money-detail-chart');
  };
  renderAllCharts();
  void document.fonts.ready.then(renderAllCharts);
  document.querySelectorAll<HTMLDetailsElement>('.value-secondary-details').forEach(details => {
    details.addEventListener('toggle', () => { if (details.open) requestAnimationFrame(renderAllCharts); });
  });
  let resizeTimer = 0;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(renderAllCharts, 120);
  });
</script>
