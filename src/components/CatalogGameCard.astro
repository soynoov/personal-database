---
import type { CatalogGame } from '../lib/catalog-game';
import { getGoldenCompletionKind } from '../lib/game-achievements';
import { buildGameCoverUrl } from '../lib/game-cover-url';
import { normalizeStatus } from '../lib/game-status';
import { hasGameTag } from '../lib/game-tags';
import trophyIcon from '@tabler/icons/outline/trophy.svg?url';
import TablerIcon from './TablerIcon.astro';
import GamePill from './GamePill.astro';

interface Props {
  game: CatalogGame;
  eager?: boolean;
}

const { game, eager = false } = Astro.props;

const goldenCompletionKind = getGoldenCompletionKind(game);
const hasPlatinum = goldenCompletionKind !== null;
const goldenAriaLabel = goldenCompletionKind === 'game'
  ? 'Juego completado al 100%'
  : '100% de logros completados';
const isFreeToPlay = hasGameTag(game.tags, 'free-to-play');
const isEarlyAccess = hasGameTag(game.tags, 'early-access') || (game.generos?.some((genre) => {
  const normalized = normalizeStatus(genre);
  return normalized === 'acceso anticipado' || normalized === 'early access';
}) ?? false);
const support = [game.lanzamiento, game.generos?.slice(0, 2).join(', ')].filter(Boolean);
---

<a class:list={['card', 'mock-game-card', { 'is-platinum': hasPlatinum }]} href={`/games/${game.slug}/`}>
  <div class='card-main'>
    <div class='card-cover'>
      <img
        src={buildGameCoverUrl(game)}
        alt=''
        aria-hidden='true'
        loading={eager ? 'eager' : 'lazy'}
        decoding='async'
      />
    </div>
    <span class='card-foil' aria-hidden='true'></span>
    {hasPlatinum && (
      <span class='platinum-badge' aria-label={goldenAriaLabel}>
        <TablerIcon src={trophyIcon} />
      </span>
    )}
    <div class='card-body'>
      <div class='card-head'>
        <div class='card-title-stack'>
          <h2>{game.titulo}</h2>
          <div class='card-platform-badges'>
            {game.plataforma && (
              <GamePill kind="platform" value={game.plataforma} />
            )}
            {game.launcher && (
              <GamePill kind="launcher" value={game.launcher} />
            )}
          </div>
        </div>
      </div>
      <div class='badges'>
        <GamePill kind="status" value={game.estado} />
        {isFreeToPlay && <GamePill kind="tag" value="free-to-play" />}
        {isEarlyAccess && <GamePill kind="tag" value="early-access" />}
      </div>
      <dl class='meta'>
        <div>
          <dt>Horas</dt>
          <dd>{game.horas == null ? '-' : new Intl.NumberFormat('es-ES', { maximumFractionDigits: 1 }).format(game.horas)}</dd>
        </div>
      </dl>
      <p class='card-support'>
        {support.length > 0 ? support.map((part, index) => (
          <>
            {index > 0 && <span class='support-separator' aria-hidden='true'> | </span>}
            <span>{part}</span>
          </>
        )) : 'Sin contexto'}
      </p>
    </div>
  </div>
</a>
