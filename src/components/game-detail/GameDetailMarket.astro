---
import type { GameMarketView } from '../../lib/game-market-view';
import { formatEuro } from '../../lib/game-finance';
import GameDetailDlcBalance from './GameDetailDlcBalance.astro';
import PurchaseBalance from './PurchaseBalance.astro';
interface Props { slug: string; market: GameMarketView; purchasedUnits: number }
const { slug, market, purchasedUnits } = Astro.props;
const { dlcs } = market;
const showBase = !market.isFreeToPlay && (market.baseApplicable || market.points.length > 0 || market.historicLow !== null);
const payload = { type: 'price-references', points: market.points, historicLow: market.historicLow, purchaseState: market.baseUnitBalance.state };
---

{showBase && <section class="base-purchase-bento" id="base-price-reference" aria-label="Compra del juego base">
  <div class="base-purchase-result">
    <PurchaseBalance label="Compra del juego base" balance={market.baseBalance} compact />
    {purchasedUnits > 1 && <p class="purchase-scope">Balance de las {purchasedUnits} copias compradas.</p>}
  </div>
  <div class="base-purchase-reference">
    {market.points.length >= 2 ? <>
      <div class="base-purchase-chart"><canvas id="money-detail-chart" role="img" aria-label={`Referencias de precio por copia: ${market.points.map(point => `${point.label}: ${formatEuro(point.value)}`).join('; ')}`} data-chart={JSON.stringify(payload)}></canvas></div>
      <p class="purchase-chart-note">Referencias registradas por copia; no es un historial.</p>
    </> : <dl class="base-purchase-prices">
      <div><dt>Mi compra</dt><dd>{formatEuro(market.paid, 'Sin registrar')}</dd></div>
      <div><dt>Precio actual</dt><dd>{formatEuro(market.current, 'Sin registrar')}</dd></div>
    </dl>}
    {market.historicLow !== null && <p class="purchase-chart-note">{market.points.length >= 2 ? 'Línea discontinua: mínimo histórico' : 'Mínimo histórico'} · {formatEuro(market.historicLow)}</p>}
  </div>
</section>}
{market.hasDlcs && <GameDetailDlcBalance {slug} {dlcs} />}
