---
import '../../styles/game-detail/topbar.css';
import '../../styles/game-detail/edit.css';
import { normalizeStatus } from '../../lib/game-status';
import FormCheckbox from '../FormCheckbox.astro';
import TablerIcon from '../TablerIcon.astro';
import arrowLeftIcon from '@tabler/icons/outline/arrow-left.svg?url';
import editIcon from '@tabler/icons/outline/edit.svg?url';

interface EditValues {
  estado: string | null;
  dificultad: string | null;
  logros_actual: number | null;
  logros_total: number | null;
  fecha_inicio: string | null;
  fecha_fin: string | null;
}

interface Props { slug: string; editValues: EditValues }
const { slug, editValues } = Astro.props;
const KNOWN_ESTADOS = ['Jugando', 'Terminado', 'Pendiente', 'Wishlist', 'Pausado', 'Abandonado', 'Retirado', 'Recurrente'];
const currentStatus = normalizeStatus(editValues.estado);
const estadoOptions = editValues.estado && !KNOWN_ESTADOS.some((estado) => normalizeStatus(estado) === currentStatus)
  ? [...KNOWN_ESTADOS, editValues.estado]
  : KNOWN_ESTADOS;
---

<div class="game-page-topbar">
  <a class="back-link" href="/"><TablerIcon src={arrowLeftIcon} /><span>Biblioteca</span></a>
  <button class="game-edit-trigger" id="game-edit-trigger" type="button" aria-label="Editar resumen">
    <TablerIcon src={editIcon} />
    <span class="game-edit-trigger-label">Editar resumen</span>
  </button>
</div>

<dialog class="edit-dialog" id="game-edit-dialog">
  <div class="edit-dialog-body">
    <div class="edit-dialog-head">
      <h2>Editar resumen</h2>
      <button class="edit-dialog-close" id="game-edit-close" type="button" aria-label="Cerrar">×</button>
    </div>
    <p class="edit-dialog-error" id="game-edit-error" hidden></p>
    <form id="game-edit-form" data-slug={slug} data-start-date={editValues.fecha_inicio ?? ''} data-end-date={editValues.fecha_fin ?? ''}>
      <div class="edit-field">
        <label for="edit-estado">Estado</label>
        <select id="edit-estado" name="estado">
          {estadoOptions.map((estado) => <option value={estado} selected={normalizeStatus(estado) === currentStatus}>{estado}</option>)}
        </select>
      </div>
      <FormCheckbox class="date-proposal" id="start-date-proposal" inputId="start-date-proposal-input" hidden checked>
        Registrar hoy como fecha de inicio
      </FormCheckbox>
      <FormCheckbox class="date-proposal" id="end-date-proposal" inputId="end-date-proposal-input" hidden checked>
        Registrar hoy como fecha de fin
      </FormCheckbox>
      <div class="edit-field">
        <label for="edit-dificultad">Dificultad</label>
        <input id="edit-dificultad" name="dificultad" type="text" placeholder="Fácil, normal, difícil…" value={editValues.dificultad ?? ''} />
      </div>
      <div class="edit-field-row">
        <div class="edit-field">
          <label for="edit-logros-actual">Logros conseguidos</label>
          <input id="edit-logros-actual" name="logros_actual" type="number" step="1" min="0" value={editValues.logros_actual ?? ''} />
        </div>
        <div class="edit-field">
          <label for="edit-logros-total">Logros totales</label>
          <input id="edit-logros-total" name="logros_total" type="number" step="1" min="0" value={editValues.logros_total ?? ''} />
        </div>
      </div>
      <div class="edit-dialog-actions">
        <button class="edit-dialog-cancel" id="game-edit-cancel" type="button">Cancelar</button>
        <button class="edit-dialog-submit" id="game-edit-submit" type="submit">Guardar cambios</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { editorFetch } from '../../scripts/editor-auth';
  import { finishGameEdit, getMadridToday, restoreGameEditFeedback } from '../../scripts/game-edit-feedback';

  restoreGameEditFeedback();
  const trigger = document.getElementById('game-edit-trigger');
  const dialog = document.getElementById('game-edit-dialog');
  const form = document.getElementById('game-edit-form');
  const errorBox = document.getElementById('game-edit-error');
  const submit = document.getElementById('game-edit-submit');
  if (trigger instanceof HTMLButtonElement && dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement && errorBox instanceof HTMLElement && submit instanceof HTMLButtonElement) {
    const status = document.getElementById('edit-estado');
    const startProposal = document.getElementById('start-date-proposal');
    const endProposal = document.getElementById('end-date-proposal');
    const syncDateProposal = () => {
      if (!(status instanceof HTMLSelectElement) || !(startProposal instanceof HTMLElement) || !(endProposal instanceof HTMLElement)) return;
      const normalized = status.value.trim().toLowerCase();
      startProposal.hidden = normalized !== 'jugando' || Boolean(form.dataset.startDate);
      endProposal.hidden = !['terminado', 'completado'].includes(normalized) || Boolean(form.dataset.endDate);
    };
    status?.addEventListener('change', syncDateProposal);
    syncDateProposal();
    const close = () => dialog.close();
    trigger.addEventListener('click', () => { errorBox.hidden = true; dialog.showModal(); });
    document.getElementById('game-edit-close')?.addEventListener('click', close);
    document.getElementById('game-edit-cancel')?.addEventListener('click', close);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const startChoice = document.getElementById('start-date-proposal-input');
      const endChoice = document.getElementById('end-date-proposal-input');
      const payload: Record<string, unknown> = {
        estado: data.get('estado'),
        dificultad: data.get('dificultad'),
        logros_actual: data.get('logros_actual'),
        logros_total: data.get('logros_total'),
      };
      if (!form.dataset.startDate && startProposal instanceof HTMLElement && !startProposal.hidden && startChoice instanceof HTMLInputElement && startChoice.checked) payload.fecha_inicio = getMadridToday();
      if (!form.dataset.endDate && endProposal instanceof HTMLElement && !endProposal.hidden && endChoice instanceof HTMLInputElement && endChoice.checked) payload.fecha_fin = getMadridToday();
      submit.disabled = true;
      submit.textContent = 'Guardando…';
      try {
        const response = await editorFetch(`/api/games/${form.dataset.slug ?? ''}/edit`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || `HTTP ${response.status}`);
        finishGameEdit('game-header', 'Resumen actualizado');
      } catch (error) {
        errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar.';
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Guardar cambios';
      }
    });
  }
</script>
