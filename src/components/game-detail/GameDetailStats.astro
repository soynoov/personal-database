---
import '../../styles/game-detail/stats.css';
import '../../styles/game-detail/edit.css';
import { GAME_MODES } from '../../lib/game-modes';
import { PUBLIC_GAME_TAGS, normalizeGameTag } from '../../lib/game-tags';
import FormCheckbox from '../FormCheckbox.astro';
import TablerIcon from '../TablerIcon.astro';
import editIcon from '@tabler/icons/outline/edit.svg?url';

interface Props {
  slug: string;
  metadataGroups: Array<{
    title: string;
    items: Array<{ label: string; value: string; className?: string; note?: string }>;
  }>;
  editValues: { generos: string[]; tags: string[]; modos: string[] };
}
const { slug, metadataGroups, editValues } = Astro.props;
const normalizedTags = editValues.tags.map(normalizeGameTag);
---

<section class="game-page-section" id="technical">
  <div class="section-title-row">
    <div><span class="section-eyebrow">Ficha técnica</span><h2>Datos</h2></div>
    <button class="game-edit-trigger game-edit-trigger-sm" id="data-edit-trigger" type="button" aria-label="Editar datos"><TablerIcon src={editIcon} /></button>
  </div>
  <div class="game-data-groups">
    {metadataGroups.map((group) => (
      <article class="data-group-card">
        <div class="data-group-head"><h3>{group.title}</h3></div>
        <dl class="detail-grid detail-grid-2">
          {group.items.map(({ label, value, className = '', note = '' }) => (
            <div title={note || undefined} class:list={["detail-item", "compact-detail-card", className, value === '-' && "detail-item-empty"]}>
              <dt>{label}</dt><dd>{value}</dd>
            </div>
          ))}
        </dl>
      </article>
    ))}
  </div>
</section>

<dialog class="edit-dialog" id="data-edit-dialog">
  <div class="edit-dialog-body">
    <div class="edit-dialog-head">
      <h2>Editar datos</h2>
      <button class="edit-dialog-close" id="data-edit-close" type="button" aria-label="Cerrar">×</button>
    </div>
    <p class="edit-dialog-error" id="data-edit-error" hidden></p>
    <form id="data-edit-form" data-slug={slug}>
      <div class="edit-field">
        <label for="data-edit-genres">Géneros</label>
        <input id="data-edit-genres" name="generos" type="text" value={editValues.generos.join(', ')} placeholder="Acción, Aventura…" />
      </div>
      <fieldset class="edit-field game-mode-fieldset">
        <legend>Modos</legend>
        <div class="game-mode-options">
          {GAME_MODES.map((mode) => (
            <FormCheckbox class="game-mode-option" name="modos" value={mode.value} checked={editValues.modos.includes(mode.value)}>
              {mode.label}
            </FormCheckbox>
          ))}
        </div>
      </fieldset>
      <fieldset class="edit-field game-mode-fieldset">
        <legend>Etiquetas</legend>
        <div class="game-mode-options">
          {PUBLIC_GAME_TAGS.map((tag) => (
            <FormCheckbox class="game-mode-option" name="tags" value={tag.value} checked={normalizedTags.includes(tag.value)}>
              {tag.label}
            </FormCheckbox>
          ))}
        </div>
      </fieldset>
      <div class="edit-dialog-actions">
        <button class="edit-dialog-cancel" id="data-edit-cancel" type="button">Cancelar</button>
        <button class="edit-dialog-submit" id="data-edit-submit" type="submit">Guardar cambios</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { editorFetch } from '../../scripts/editor-auth';
  import { finishGameEdit } from '../../scripts/game-edit-feedback';
  const trigger = document.getElementById('data-edit-trigger');
  const dialog = document.getElementById('data-edit-dialog');
  const form = document.getElementById('data-edit-form');
  const errorBox = document.getElementById('data-edit-error');
  const submit = document.getElementById('data-edit-submit');
  if (trigger instanceof HTMLButtonElement && dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement && errorBox instanceof HTMLElement && submit instanceof HTMLButtonElement) {
    const close = () => dialog.close();
    trigger.addEventListener('click', () => { errorBox.hidden = true; dialog.showModal(); });
    document.getElementById('data-edit-close')?.addEventListener('click', close);
    document.getElementById('data-edit-cancel')?.addEventListener('click', close);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      submit.disabled = true;
      submit.textContent = 'Guardando…';
      try {
        const response = await editorFetch(`/api/games/${form.dataset.slug ?? ''}/edit`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ generos: data.get('generos'), modos: data.getAll('modos'), tags: data.getAll('tags') }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || `HTTP ${response.status}`);
        finishGameEdit('technical', 'Datos actualizados');
      } catch (error) {
        errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar.';
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Guardar cambios';
      }
    });
  }
</script>
