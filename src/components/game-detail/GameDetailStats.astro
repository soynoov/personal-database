---
import '../../styles/game-detail/stats.css';
import '../../styles/game-detail/edit.css';
import { GAME_MODES } from '../../lib/game-modes';
import { PUBLIC_GAME_TAGS, normalizeGameTag } from '../../lib/game-tags';
import FormCheckbox from '../FormCheckbox.astro';
import TablerIcon from '../TablerIcon.astro';
import categoryIcon from '@tabler/icons/outline/category-2.svg?url';
import editIcon from '@tabler/icons/outline/edit.svg?url';
import settingsIcon from '@tabler/icons/outline/settings.svg?url';
import trophyIcon from '@tabler/icons/outline/trophy.svg?url';
import cardsIcon from '@tabler/icons/outline/cards.svg?url';
import difficultyIcon from '@tabler/icons/outline/barbell.svg?url';

type ProgressKind = 'difficulty' | 'achievements' | 'cards';

interface Props {
  slug: string;
  metadataGroups: Array<{
    title: string;
    className?: string;
    items: Array<{ label: string; value: string; className?: string; note?: string; progress?: number | null; kind?: ProgressKind }>;
  }>;
  editValues: {
    generos: string[];
    tags: string[];
    modos: string[];
    launcher: string | null;
    plataforma: string | null;
    tamano: string | null;
    lanzamiento: number | null;
    steam_appid: number | null;
    hltb_match: string | null;
    dificultad: string | null;
    logros_actual: number | null;
    logros_total: number | null;
    steam_cromos_actual: number | null;
    steam_cromos_total: number | null;
  };
}
const { slug, metadataGroups, editValues } = Astro.props;
const normalizedTags = editValues.tags.map(normalizeGameTag);
const groupIcons: Record<string, string> = {
  'Catalogación': categoryIcon,
  Progreso: trophyIcon,
  'Ficha técnica': settingsIcon,
};
const progressIcons: Record<ProgressKind, string> = {
  difficulty: difficultyIcon,
  achievements: trophyIcon,
  cards: cardsIcon,
};
---

<section class="game-page-section" id="technical">
  <div class="section-title-row">
    <div><span class="section-eyebrow">Ficha técnica</span><h2>Datos</h2></div>
    <button class="game-edit-trigger game-edit-trigger-sm" id="data-edit-trigger" type="button" aria-label="Editar catalogación y ficha técnica"><TablerIcon src={editIcon} /></button>
  </div>
  <div class="game-data-groups">
    {metadataGroups.map((group) => (
      <article class:list={["data-group-card", group.className]}>
        <div class="data-group-head">
          <span class="data-group-icon"><TablerIcon src={groupIcons[group.title] ?? settingsIcon} /></span>
          <h3>{group.title}</h3>
        </div>
        <dl class="detail-grid data-group-grid" data-count={group.items.length}>
          {group.items.map(({ label, value, className = '', note = '', progress = null, kind }) => (
            <div title={note || undefined} class:list={["detail-item", "compact-detail-card", className, kind && `progress-card-${kind}`, value === '-' && "detail-item-empty", progress !== null && "detail-item-progress", progress !== null && progress >= 100 && "detail-item-complete"]}>
              {kind && <span class='progress-card-icon'><TablerIcon src={progressIcons[kind]} /></span>}
              <dt>{label}</dt>
              <dd>{value}</dd>
              {note && <dd class="detail-item-note">{note}</dd>}
              {progress !== null && (
                <dd class="data-progress-slot">
                  <span class="data-progress-track" role="progressbar" aria-label={`Progreso de ${label}`} aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(progress)}>
                    <span style={`--data-progress:${progress}%`}></span>
                  </span>
                </dd>
              )}
            </div>
          ))}
        </dl>
      </article>
    ))}
  </div>
</section>

<dialog class="edit-dialog" id="data-edit-dialog">
  <div class="edit-dialog-body">
    <div class="edit-dialog-head">
      <h2>Editar datos</h2>
      <button class="edit-dialog-close" id="data-edit-close" type="button" aria-label="Cerrar">×</button>
    </div>
    <p class="edit-dialog-error" id="data-edit-error" hidden></p>
    <form id="data-edit-form" data-slug={slug}>
      <fieldset class="data-edit-fieldset">
        <legend>Catalogación</legend>
        <div class="edit-field">
          <label for="data-edit-genres">Géneros</label>
          <input id="data-edit-genres" name="generos" type="text" value={editValues.generos.join(', ')} placeholder="Acción, Aventura…" />
        </div>
        <fieldset class="edit-field game-mode-fieldset">
          <legend>Modos</legend>
          <div class="game-mode-options">
            {GAME_MODES.map((mode) => (
              <FormCheckbox class="game-mode-option" name="modos" value={mode.value} checked={editValues.modos.includes(mode.value)}>
                {mode.label}
              </FormCheckbox>
            ))}
          </div>
        </fieldset>
        <fieldset class="edit-field game-mode-fieldset">
          <legend>Etiquetas</legend>
          <div class="game-mode-options">
            {PUBLIC_GAME_TAGS.map((tag) => (
              <FormCheckbox class="game-mode-option" name="tags" value={tag.value} checked={normalizedTags.includes(tag.value)}>
                {tag.label}
              </FormCheckbox>
            ))}
          </div>
        </fieldset>
      </fieldset>
      <fieldset class="data-edit-fieldset">
        <legend>Progreso</legend>
        <div class="edit-field">
          <label for="data-edit-difficulty">Dificultad</label>
          <input id="data-edit-difficulty" name="dificultad" type="text" placeholder="Fácil, normal, difícil…" value={editValues.dificultad ?? ''} />
        </div>
        <div class="edit-field-row">
          <div class="edit-field">
            <label for="data-edit-achievements-current">Logros conseguidos</label>
            <input id="data-edit-achievements-current" name="logros_actual" type="number" step="1" min="0" value={editValues.logros_actual ?? ''} />
          </div>
          <div class="edit-field">
            <label for="data-edit-achievements-total">Logros totales</label>
            <input id="data-edit-achievements-total" name="logros_total" type="number" step="1" min="0" value={editValues.logros_total ?? ''} />
          </div>
        </div>
        <div class="edit-field-row steam-cards-edit-row">
          <div class="edit-field">
            <label for="data-edit-cards-current">Cromos obtenidos</label>
            <input id="data-edit-cards-current" name="steam_cromos_actual" type="number" step="1" min="0" value={editValues.steam_cromos_actual ?? ''} />
          </div>
          <div class="edit-field">
            <label for="data-edit-cards-total">Cromos totales</label>
            <input id="data-edit-cards-total" name="steam_cromos_total" type="number" step="1" min="0" value={editValues.steam_cromos_total ?? ''} />
          </div>
        </div>
      </fieldset>
      <fieldset class="data-edit-fieldset">
        <legend>Ficha técnica</legend>
        <div class="edit-field-row">
          <div class="edit-field">
            <label for="data-edit-launcher">Launcher</label>
            <input id="data-edit-launcher" name="launcher" type="text" value={editValues.launcher ?? ''} />
          </div>
          <div class="edit-field">
            <label for="data-edit-platform">Plataforma</label>
            <input id="data-edit-platform" name="plataforma" type="text" value={editValues.plataforma ?? ''} />
          </div>
        </div>
        <div class="edit-field-row">
          <div class="edit-field">
            <label for="data-edit-size">Tamaño instalado</label>
            <input id="data-edit-size" name="tamano" type="text" value={editValues.tamano ?? ''} placeholder="30.32 GB" />
          </div>
          <div class="edit-field">
            <label for="data-edit-release">Año de lanzamiento</label>
            <input id="data-edit-release" name="lanzamiento" type="number" step="1" min="1" value={editValues.lanzamiento ?? ''} />
          </div>
        </div>
        <div class="edit-field-row">
          <div class="edit-field">
            <label for="data-edit-steam-appid">Steam AppID</label>
            <input id="data-edit-steam-appid" name="steam_appid" type="number" step="1" min="1" value={editValues.steam_appid ?? ''} />
          </div>
          <div class="edit-field">
            <label for="data-edit-hltb-match">Coincidencia HLTB</label>
            <input id="data-edit-hltb-match" name="hltb_match" type="text" value={editValues.hltb_match ?? ''} />
          </div>
        </div>
      </fieldset>
      <div class="edit-dialog-actions">
        <button class="edit-dialog-cancel" id="data-edit-cancel" type="button">Cancelar</button>
        <button class="edit-dialog-submit" id="data-edit-submit" type="submit">Guardar cambios</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { editorFetch } from '../../scripts/editor-auth';
  import { finishGameEdit } from '../../scripts/game-edit-feedback';
  const trigger = document.getElementById('data-edit-trigger');
  const dialog = document.getElementById('data-edit-dialog');
  const form = document.getElementById('data-edit-form');
  const errorBox = document.getElementById('data-edit-error');
  const submit = document.getElementById('data-edit-submit');
  if (trigger instanceof HTMLButtonElement && dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement && errorBox instanceof HTMLElement && submit instanceof HTMLButtonElement) {
    const close = () => dialog.close();
    trigger.addEventListener('click', () => { errorBox.hidden = true; dialog.showModal(); });
    document.getElementById('data-edit-close')?.addEventListener('click', close);
    document.getElementById('data-edit-cancel')?.addEventListener('click', close);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      submit.disabled = true;
      submit.textContent = 'Guardando…';
      try {
        const response = await editorFetch(`/api/games/${form.dataset.slug ?? ''}/edit`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            generos: data.get('generos'),
            modos: data.getAll('modos'),
            tags: data.getAll('tags'),
            launcher: data.get('launcher'),
            plataforma: data.get('plataforma'),
            tamano: data.get('tamano'),
            lanzamiento: data.get('lanzamiento'),
            steam_appid: data.get('steam_appid'),
            hltb_match: data.get('hltb_match'),
            dificultad: data.get('dificultad'),
            logros_actual: data.get('logros_actual'),
            logros_total: data.get('logros_total'),
            steam_cromos_actual: data.get('steam_cromos_actual'),
            steam_cromos_total: data.get('steam_cromos_total'),
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || `HTTP ${response.status}`);
        finishGameEdit('technical', 'Datos actualizados');
      } catch (error) {
        errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar.';
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Guardar cambios';
      }
    });
  }
</script>
