---
import '../../styles/game-detail/dlc-card.css';
import GamePill from '../GamePill.astro';
import { formatEuro } from '../../lib/game-finance';
import { getDlcCardView, type DlcItem } from '../../lib/game-dlc-view';
import { formatSignedEuro, formatSignedPercent } from '../../lib/price-balance';

interface Props { dlc: DlcItem; gameTitle?: string }
const { dlc, gameTitle = '' } = Astro.props;
const view = getDlcCardView(dlc, gameTitle);
---

<article class:list={['dlc-showcase-card', !view.owned && 'dlc-showcase-card-unowned']}
  data-price={view.paid ?? ''} data-owned={view.owned ? '1' : '0'}
  data-date={dlc.fecha_adquisicion ?? ''} data-title={view.fullTitle.toLowerCase()}>
  <div class="dlc-showcase-heading">
    <div class="dlc-showcase-cover">
      {dlc.cover_url && <img src={dlc.cover_url} alt="" loading="lazy"
        onerror="this.style.display='none'; this.nextElementSibling.hidden=false;" />}
      <span class="dlc-showcase-cover-empty" hidden={Boolean(dlc.cover_url)}>Sin portada</span>
    </div>
    <div class="dlc-showcase-copy">
      <h3 title={view.fullTitle}>{view.title}</h3>
      {view.owned ? <p class="dlc-showcase-acquired">Adquirido · {view.dateLabel}</p>
        : <GamePill class="dlc-showcase-unowned-badge" value="No adquirido" />}
    </div>
  </div>
  <dl class:list={['dlc-showcase-prices', !view.owned && 'is-unowned']}>
    {view.owned && <div><dt>Pagué</dt><dd>{formatEuro(view.paid, 'Sin dato')}</dd></div>}
    <div><dt>{view.owned ? 'Hoy' : 'Precio actual'}</dt><dd>{formatEuro(view.current, 'Sin dato')}</dd></div>
    {view.owned && <div class="dlc-showcase-balance" data-balance={view.balance.state}>
      <dt>Balance</dt><dd title={view.balance.difference === null ? 'Falta el precio pagado o el actual' : `${formatSignedPercent(view.balance.percent)} frente al precio pagado`}>{formatSignedEuro(view.balance.difference)}</dd>
    </div>}
  </dl>
</article>
