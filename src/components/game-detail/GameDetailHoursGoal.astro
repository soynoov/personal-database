---
import '../../styles/game-detail/hours-goal.css';
import { formatHoursDuration, type GameValueMetrics } from '../../lib/game-finance';
import { getEconomicHoursGoal } from '../../lib/game-hours-goal';
import TablerIcon from '../TablerIcon.astro';
import GamePill from '../GamePill.astro';
import targetIcon from '@tabler/icons/outline/target-arrow.svg?url';
import checkIcon from '@tabler/icons/outline/check.svg?url';

interface Props { metrics: GameValueMetrics; estimated?: boolean }
const { metrics, estimated = false } = Astro.props;
const goal = getEconomicHoursGoal(metrics);
const headline = goal.state === 'achieved' ? 'Meta alcanzada'
  : goal.state === 'in-progress' ? `Faltan ${formatHoursDuration(goal.remainingHours)}`
  : goal.state === 'no-cost' ? 'Sin coste que amortizar'
  : goal.state === 'missing-hours' ? 'Registra tus horas'
  : 'Falta completar el gasto';
const actualLabel = goal.actualHours === null ? 'Sin registrar'
  : `${estimated ? '≈' : ''}${formatHoursDuration(goal.actualHours)}`;
const bonusNote = metrics.scoreBonusPercent > 0
  ? `Bonus My Score +${metrics.scoreBonusPercent.toLocaleString('es-ES')}% aplicado a la meta.`
  : 'Sin bonus de nota.';
const progressDescription = `${headline}. ${estimated ? 'Horas estimadas' : 'Horas jugadas'}: ${actualLabel}. Meta: ${formatHoursDuration(goal.targetHours)}.`;
---

<section class="hours-goal-card" data-hours-goal={goal.state} data-usage-provisional={goal.provisional} aria-labelledby="hours-goal-title">
  <div class="hours-goal-heading">
    <span class="hours-goal-icon"><TablerIcon src={goal.state === 'achieved' ? checkIcon : targetIcon} /></span>
    <div>
      <div class="hours-goal-label"><span class="hours-goal-eyebrow">Meta de amortización</span>{goal.provisional && <GamePill value="Provisional" />}</div>
      <h3 id="hours-goal-title">{headline}</h3>
    </div>
    {goal.progressPercent !== null && <strong class="hours-goal-percent">{goal.progressPercent}%</strong>}
  </div>

  {goal.targetHours !== null && (
    <div class="hours-goal-measure">
      <dl class="hours-goal-values">
        <div><dt>{estimated ? 'Tus horas estimadas' : 'Tus horas jugadas'}</dt><dd>{actualLabel}</dd></div>
        <div><dt>Meta</dt><dd>{formatHoursDuration(goal.targetHours)}</dd></div>
      </dl>
      {goal.progressPercent !== null && (
        <div class="hours-goal-track" role="progressbar" aria-label="Progreso hacia la meta de amortización"
          aria-valuemin="0" aria-valuemax="100" aria-valuenow={goal.progressPercent} aria-valuetext={progressDescription}>
          <span style={`--hours-goal-progress:${goal.progressPercent}%`}></span>
        </div>
      )}
      <p class="hours-goal-note">Meta en horas de juego: 1 € por hora ponderada. {bonusNote}{estimated && ' Progreso orientativo: las horas son estimadas.'}</p>
      {goal.provisional && <p class="hours-goal-note">Con el gasto conocido; la meta puede cambiar al <a href="#finance-data-notice">completar los importes pendientes</a>.</p>}
    </div>
  )}

  {goal.state === 'missing-hours' && (
    <button class="brand-button hours-goal-action" type="button" data-edit-target="hours-edit-trigger" aria-controls="hours-edit-dialog">Registrar horas</button>
  )}
  {goal.state === 'no-cost' && <p class="hours-goal-note">El gasto registrado es 0 €. No necesitas alcanzar una meta de horas.</p>}
  {goal.state === 'incomplete' && (
    <div class="hours-goal-empty">
      <p class="hours-goal-note">{metrics.incompleteReasons.join(' ')} Los importes sin registrar no se consideran cero.</p>
      {metrics.baseSpend === null
        ? <button class="brand-button hours-goal-action" type="button" data-edit-target="money-edit-trigger" aria-controls="money-edit-dialog">Registrar precio</button>
        : <a class="brand-button hours-goal-action" href="#dlcs">Revisar gasto de DLC</a>}
    </div>
  )}
</section>
