---
import { formatHoursDuration, type GameValueMetrics } from '../../lib/game-finance';
interface Props { metrics: GameValueMetrics; estimated?: boolean }
const { metrics, estimated = false } = Astro.props;
const actual = metrics.realHours;
const target = metrics.economicTargetRealHours;
const measurable = metrics.dataComplete && actual !== null && target !== null;
const scale = Math.max(actual ?? 0, target ?? 0, 1);
const remaining = metrics.economicRemainingHours ?? 0;
const complete = remaining <= 0;
const stateLabel = complete ? 'Amortizado' : `Faltan ${formatHoursDuration(remaining)}`;
const actualWidth = `width:${((actual ?? 0) / scale) * 100}%`;
const targetWidth = `width:${((target ?? 0) / scale) * 100}%`;
const bonusNote = metrics.scoreBonusPercent > 0 ? ` · bonus My Score +${metrics.scoreBonusPercent.toLocaleString('es-ES')}% aplicado a la meta` : ', sin bonus de nota';
---
{measurable && (<section class="finance-hours-chart" aria-labelledby="finance-hours-title">
  <div class="finance-hours-heading">
    <div><span class="section-eyebrow">Tiempo que compensa</span><h3 id="finance-hours-title">Horas frente a amortización</h3></div>
    <strong class:list={["finance-hours-state", complete && "is-complete"]}>{stateLabel}</strong>
  </div>
  <dl class="finance-hours-bars">
    <div><dt>{estimated ? 'Mis horas estimadas' : 'Mis horas jugadas'}</dt><dd><strong>{formatHoursDuration(actual)}</strong><span class="finance-hours-track" aria-hidden="true"><span style={actualWidth}></span></span></dd></div>
    <div class="finance-hours-target"><dt>Para amortizar</dt><dd><strong>{formatHoursDuration(target)}</strong><span class="finance-hours-track" aria-hidden="true"><span style={targetWidth}></span></span></dd></div>
  </dl>
  <p class="chart-note">Ambas barras en horas reales, desde cero. Meta: 1 € por hora ponderada{bonusNote}.</p>
</section>)}
