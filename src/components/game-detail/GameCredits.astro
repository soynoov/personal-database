---
import { isSteamAppId } from '../../lib/steam-game-credits';
import { getSavedGameCredits, getGameCreditSource, type GameCreditMetadata } from '../../lib/game-credits';

interface Props { slug: string; game: GameCreditMetadata; }
const { slug, game } = Astro.props;
const saved = getSavedGameCredits(game);
const hasSteam = isSteamAppId(game.steam_appid);
const fields = [
  { key: 'developers' as const, label: 'Desarrolladora' },
  { key: 'publishers' as const, label: 'Editora / distribuidora' },
];
---

{fields.map(({ key, label }) => {
  const value = saved[key].join(' · ');
  const source = getGameCreditSource(game, key);
  return (
    <div class="detail-item compact-detail-card game-credit" data-state={value ? 'default' : 'empty'}>
      <dt>{label}</dt>
      <dd class="detail-item-value" data-game-credit={key} data-credits-slug={!value && hasSteam ? slug : undefined} aria-live="polite">{value || 'No disponible'}</dd>
      {key === 'publishers' && source && (
        <dd class="detail-item-note"><a href={source} target="_blank" rel="noopener noreferrer">{value ? 'Fuente de los datos' : 'Fuente: ficha actual de Steam'}</a></dd>
      )}
    </div>
  );
})}

<script>
  const fields = Array.from(document.querySelectorAll<HTMLElement>('[data-game-credit][data-credits-slug]'));
  const group = fields[0]?.closest<HTMLElement>('article');
  let requested = false;

  async function loadCredits() {
    if (requested || !fields.length) return;
    requested = true;
    fields.forEach(field => { field.textContent = 'Consultando Steam…'; field.setAttribute('aria-busy', 'true'); });
    try {
      const response = await fetch(`/api/games/${encodeURIComponent(fields[0].dataset.creditsSlug ?? '')}/info`, {
        signal: AbortSignal.timeout(8000),
      });
      if (!response.ok) throw new Error('Credits unavailable');
      const data = await response.json();
      fields.forEach(field => {
        const value: unknown = data[field.dataset.gameCredit ?? ''];
        const names = Array.isArray(value) ? value.filter((name): name is string => typeof name === 'string' && Boolean(name.trim())) : [];
        field.textContent = names.join(' · ') || 'No disponible';
        if (names.length && field.parentElement) field.parentElement.dataset.state = 'default';
      });
    } catch {
      fields.forEach(field => { field.textContent = 'No disponible'; });
    } finally {
      fields.forEach(field => field.removeAttribute('aria-busy'));
    }
  }

  if (group) {
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (entries.some(entry => entry.isIntersecting)) { observer.disconnect(); void loadCredits(); }
      }, { rootMargin: '200px' });
      observer.observe(group);
    } else {
      void loadCredits();
    }
  }
</script>
