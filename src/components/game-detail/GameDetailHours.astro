---
import '../../styles/game-detail/shared.css';
import '../../styles/game-detail/hours.css';
import '../../styles/game-detail/edit.css';
import { formatHoursDuration, type GameValueMetrics } from '../../lib/game-finance';
import TablerIcon from '../TablerIcon.astro';
import chartIcon from '@tabler/icons/outline/chart-bar.svg?url';
import calendarIcon from '@tabler/icons/outline/calendar-event.svg?url';
import clockIcon from '@tabler/icons/outline/clock.svg?url';
import editIcon from '@tabler/icons/outline/edit.svg?url';
import flagIcon from '@tabler/icons/outline/flag-3.svg?url';
import playerPlayIcon from '@tabler/icons/outline/player-play.svg?url';
import targetIcon from '@tabler/icons/outline/target-arrow.svg?url';

interface Props {
  slug: string;
  metrics: GameValueMetrics;
  hoursChartPayload: object;
  hoursChartPoints: Array<{ label: string; value: number; color?: string }>;
  hltbBreakdown: { main: number | null; mainPlus: number | null; completionist: number | null };
  period: { startLabel: string; endLabel: string; elapsedDays: number | null };
  editValues: { horas: number | null; fecha_inicio: string | null; fecha_fin: string | null };
}

const { slug, metrics, hoursChartPayload, hoursChartPoints, hltbBreakdown, period, editValues } = Astro.props;
const progress = Math.max(0, Math.min(100, metrics.hltbProgressPercent ?? 0));
const chartValueCount = hoursChartPoints.length + (metrics.realHours === null ? 0 : 1);
const hasStartDate = Boolean(editValues.fecha_inicio);
const hasEndDate = Boolean(editValues.fecha_fin);
const hasPeriodData = hasStartDate || hasEndDate;
const hasHltbTarget = metrics.showHltbTarget && metrics.hltbTargetHours !== null;
const showHltbCard = metrics.showHltbTarget;
const periodSummary = period.elapsedDays !== null
  ? `${period.elapsedDays} ${period.elapsedDays === 1 ? 'día' : 'días'}`
  : hasStartDate && !hasEndDate
    ? 'En curso'
    : hasStartDate || hasEndDate
      ? 'Registro incompleto'
      : 'Sin registrar';
const hltbState = !metrics.showHltbTarget
  ? 'No aplica'
  : metrics.hltbTargetHours === null
    ? 'Sin referencia'
    : metrics.realHours === null
      ? 'Sin horas registradas'
      : (metrics.hltbRemainingHours ?? 0) > 0
        ? `Faltan ${formatHoursDuration(metrics.hltbRemainingHours)}`
        : `${metrics.hltbMultiple?.toLocaleString('es-ES', { maximumFractionDigits: 2 }) ?? '1'}× alcanzado`;
---

<article class="analysis-panel analysis-panel-hours" id="hours">
  <div class="section-title-row analysis-head">
    <div>
      <span class="section-eyebrow">Tiempo registrado</span>
      <h2>Horas</h2>
    </div>
    <button class="game-edit-trigger game-edit-trigger-sm" id="hours-edit-trigger" type="button" aria-label="Editar horas y periodo de juego">
      <TablerIcon src={editIcon} />
    </button>
  </div>

  <div class="hours-priority-grid" data-hltb={showHltbCard ? 'true' : 'false'}>
    <article class="value-kpi value-kpi-primary">
      <span class="value-kpi-icon"><TablerIcon src={clockIcon} /></span>
      <div>
        <span>Horas reales</span>
        <strong>{metrics.realHours === null ? 'Sin registrar' : formatHoursDuration(metrics.realHours)}</strong>
      </div>
    </article>

    {showHltbCard && (
      <article class:list={["value-kpi", "value-kpi-target", !hasHltbTarget && "is-null"]}>
        <span class="value-kpi-icon"><TablerIcon src={targetIcon} /></span>
        <div>
          <span>Meta HLTB</span>
          <strong>{hasHltbTarget ? formatHoursDuration(metrics.hltbTargetHours) : '—'}</strong>
          <small>{hltbState}</small>
        </div>
      </article>
    )}

    <article class:list={["hours-period-card", !hasPeriodData && "is-null"]}>
      <div class="hours-period-head">
        <span class="value-kpi-icon"><TablerIcon src={calendarIcon} /></span>
        <div>
          <span>Periodo de juego</span>
          <strong>{periodSummary}</strong>
        </div>
      </div>
      <dl class="hours-period-dates">
        <div class:list={[!hasStartDate && "is-null"]}>
          <dt><TablerIcon src={playerPlayIcon} /> Inicio</dt>
          <dd>{hasStartDate ? period.startLabel : 'Sin registrar'}</dd>
        </div>
        <div class:list={[!hasEndDate && "is-null"]}>
          <dt><TablerIcon src={flagIcon} /> Fin</dt>
          <dd>{hasEndDate ? period.endLabel : 'Sin registrar'}</dd>
        </div>
      </dl>
    </article>

    {hasHltbTarget && (
      <article class="hours-progress-card">
        <div class="hours-progress-head">
          <span>Progreso HLTB</span>
          <strong>{metrics.hltbProgressPercent === null ? '—' : `${Math.round(metrics.hltbProgressPercent)}%`}</strong>
        </div>
        <div class="value-progress" role="progressbar" aria-label="Progreso de la meta HLTB" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(progress)}>
          <span style={`--value-progress:${progress}%`}></span>
        </div>
        <div class="hours-progress-foot">
          <span>{hltbState}</span>
          {metrics.hltbRemainingHours === 0 && <strong>Meta completada</strong>}
        </div>
      </article>
    )}
  </div>

  {metrics.showHltbTarget && (hoursChartPoints.length > 0 || hltbBreakdown.mainPlus !== null || hltbBreakdown.completionist !== null) && (
    <details class="value-secondary-details" open>
      <summary><TablerIcon src={chartIcon} /><span>Comparativa y desglose HLTB</span></summary>
      <div class="hours-secondary-grid">
        <div class="chart-visual-card">
          <div class="chart-header"><strong>Tu tiempo vs. HLTB</strong><span class="chart-badge">{chartValueCount} valores</span></div>
          {hoursChartPoints.length > 0 ? (
            <div class="chart-canvas-wrap chart-canvas-wrap-hours">
              <canvas id="hours-detail-chart" data-chart={JSON.stringify(hoursChartPayload)}></canvas>
            </div>
          ) : <div class="chart-empty">Sin referencias suficientes</div>}
        </div>
        <dl class="hours-breakdown-grid">
          <div><dt>Historia</dt><dd>{formatHoursDuration(hltbBreakdown.main)}</dd></div>
          <div><dt>Historia + extras</dt><dd>{formatHoursDuration(hltbBreakdown.mainPlus)}</dd></div>
          <div><dt>100%</dt><dd>{formatHoursDuration(hltbBreakdown.completionist)}</dd></div>
        </dl>
      </div>
    </details>
  )}
</article>

<dialog class="edit-dialog" id="hours-edit-dialog">
  <div class="edit-dialog-body">
    <div class="edit-dialog-head">
      <h2>Editar horas y periodo</h2>
      <button class="edit-dialog-close" id="hours-edit-close" type="button" aria-label="Cerrar">×</button>
    </div>
    <p class="edit-dialog-error" id="hours-edit-error" hidden></p>
    <form id="hours-edit-form" data-slug={slug}>
      <div class="edit-field">
        <label for="hours-edit-value">Horas jugadas</label>
        <input id="hours-edit-value" name="horas" type="number" step="0.01" min="0" value={editValues.horas ?? ''} />
      </div>
      <fieldset class="hours-period-fieldset">
        <legend>Periodo de juego</legend>
        <div class="edit-field-row">
          <div class="edit-field">
            <label for="hours-edit-start">Inicio</label>
            <input id="hours-edit-start" name="fecha_inicio" type="date" value={editValues.fecha_inicio ?? ''} />
          </div>
          <div class="edit-field">
            <label for="hours-edit-end">Fin</label>
            <input id="hours-edit-end" name="fecha_fin" type="date" value={editValues.fecha_fin ?? ''} />
          </div>
        </div>
      </fieldset>
      <div class="edit-dialog-actions">
        <button class="edit-dialog-cancel" id="hours-edit-cancel" type="button">Cancelar</button>
        <button class="edit-dialog-submit" id="hours-edit-submit" type="submit">Guardar cambios</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { editorFetch } from '../../scripts/editor-auth';
  import { finishGameEdit } from '../../scripts/game-edit-feedback';

  const trigger = document.getElementById('hours-edit-trigger');
  const dialog = document.getElementById('hours-edit-dialog');
  const form = document.getElementById('hours-edit-form');
  const errorBox = document.getElementById('hours-edit-error');
  const submit = document.getElementById('hours-edit-submit');
  if (trigger instanceof HTMLButtonElement && dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement && errorBox instanceof HTMLElement && submit instanceof HTMLButtonElement) {
    const close = () => dialog.close();
    trigger.addEventListener('click', () => { errorBox.hidden = true; dialog.showModal(); });
    document.getElementById('hours-edit-close')?.addEventListener('click', close);
    document.getElementById('hours-edit-cancel')?.addEventListener('click', close);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      submit.disabled = true;
      submit.textContent = 'Guardando…';
      try {
        const response = await editorFetch(`/api/games/${form.dataset.slug ?? ''}/edit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            horas: data.get('horas'),
            fecha_inicio: data.get('fecha_inicio'),
            fecha_fin: data.get('fecha_fin'),
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || `HTTP ${response.status}`);
        finishGameEdit('hours', 'Horas y periodo actualizados');
      } catch (error) {
        errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar.';
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Guardar cambios';
      }
    });
  }
</script>
