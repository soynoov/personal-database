---
import '../../styles/game-detail/shared.css';
import '../../styles/game-detail/hours.css';
import '../../styles/game-detail/edit.css';
import '../../styles/game-detail/launcher-hours.css';
import type { LauncherHours } from '../../lib/game-hours.mjs';
import LauncherHourRow from './LauncherHourRow.astro';
import { formatHoursDuration, type GameValueMetrics } from '../../lib/game-finance';
import FormCheckbox from '../FormCheckbox.astro';
import GameDetailHoursGoal from './GameDetailHoursGoal.astro';
import GameDetailUsageBreakdown from './GameDetailUsageBreakdown.astro';
import TablerIcon from '../TablerIcon.astro';
import calendarIcon from '@tabler/icons/outline/calendar-event.svg?url';
import clockIcon from '@tabler/icons/outline/clock.svg?url';
import editIcon from '@tabler/icons/outline/edit.svg?url';
import flagIcon from '@tabler/icons/outline/flag-3.svg?url';
import playerPlayIcon from '@tabler/icons/outline/player-play.svg?url';
import targetIcon from '@tabler/icons/outline/target-arrow.svg?url';

interface Props {
  slug: string;
  hourEntries: LauncherHours[];
  metrics: GameValueMetrics;
  hltbBreakdown: { main: number | null; mainPlus: number | null; completionist: number | null };
  period: { startLabel: string; endLabel: string; elapsedDays: number | null };
  editValues: { horas: number | null; horas_estimadas: boolean; fecha_inicio: string | null; fecha_fin: string | null };
  isRecurring?: boolean;
}

const { slug, hourEntries, metrics, hltbBreakdown, period, editValues, isRecurring = false } = Astro.props;
const progress = Math.max(0, Math.min(100, metrics.hltbProgressPercent ?? 0));
const hltbReferences = metrics.showHltbTarget ? [
  { label: 'Historia', value: hltbBreakdown.main },
  { label: 'Historia+', value: hltbBreakdown.mainPlus },
  { label: '100%', value: hltbBreakdown.completionist },
].filter((entry): entry is { label: string; value: number } => entry.value !== null && Number.isFinite(entry.value)) : [];
const hasHltbBreakdown = hltbReferences.length > 0;
const hasStartDate = Boolean(editValues.fecha_inicio);
const hasEndDate = !isRecurring && Boolean(editValues.fecha_fin);
const hasPeriodData = hasStartDate || hasEndDate;
const hasHltbTarget = metrics.showHltbTarget && metrics.hltbTargetHours !== null;
const showHltbCard = hasHltbTarget;
const periodSummary = isRecurring
  ? 'Recurrente'
  : period.elapsedDays !== null
  ? `${period.elapsedDays} ${period.elapsedDays === 1 ? 'día' : 'días'}`
  : hasStartDate && !hasEndDate
    ? 'En curso'
    : hasStartDate || hasEndDate
      ? 'Registro incompleto'
      : 'Sin registrar';
const hltbState = !metrics.showHltbTarget
  ? 'No aplica'
  : metrics.hltbTargetHours === null
    ? 'Sin referencia'
    : metrics.realHours === null
      ? 'Sin horas registradas'
      : (metrics.hltbRemainingHours ?? 0) > 0
        ? `Faltan ${formatHoursDuration(metrics.hltbRemainingHours)}`
        : `${metrics.hltbMultiple?.toLocaleString('es-ES', { maximumFractionDigits: 2 }) ?? '1'}× alcanzado`;
---

<article class="analysis-panel analysis-panel-hours" id="hours">
  <div class="section-title-row analysis-head">
    <div>
      <span class="section-eyebrow">{editValues.horas_estimadas ? 'Tiempo estimado' : 'Tiempo registrado'}</span>
      <h2>Horas</h2>
    </div>
    <button class="game-edit-trigger game-edit-trigger-sm" id="hours-edit-trigger" type="button" aria-label="Editar horas y periodo de juego">
      <TablerIcon src={editIcon} />
    </button>
  </div>

  <div class="hours-priority-grid" data-hltb={showHltbCard ? 'true' : 'false'} data-recurring={isRecurring ? 'true' : 'false'}>
    <article class:list={['value-kpi', 'value-kpi-primary', metrics.realHours === null && 'is-null']}>
      <span class="value-kpi-icon"><TablerIcon src={clockIcon} /></span>
      <div class="value-kpi-copy">
        <span>{editValues.horas_estimadas ? 'Horas estimadas' : hourEntries.length > 1 ? 'Total registrado' : 'Horas reales'}</span>
        <strong>{metrics.realHours === null ? 'Sin registrar' : `${editValues.horas_estimadas ? '≈' : ''}${formatHoursDuration(metrics.realHours)}`}</strong>
      </div>
    </article>

    {showHltbCard && (
      <article class:list={["value-kpi", "value-kpi-target", !hasHltbTarget && "is-null"]}>
        <span class="value-kpi-icon"><TablerIcon src={targetIcon} /></span>
        <div class="value-kpi-copy hours-target-copy">
          <span>Meta HLTB</span>
          <strong>{hasHltbTarget ? formatHoursDuration(metrics.hltbTargetHours) : '—'}</strong>
          <small>{hltbState}</small>
          {metrics.hltbProgressPercent !== null && (
            <div class="hours-target-progress">
              <div class="value-progress" role="progressbar" aria-label="Progreso de la meta HLTB" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(progress)}>
                <span style={`--value-progress:${progress}%`}></span>
              </div>
              <span>{Math.round(metrics.hltbProgressPercent)}%</span>
            </div>
          )}
        </div>
      </article>
    )}

    <article class:list={["hours-info-card", "hours-period-summary", !isRecurring && !hasPeriodData && "is-null"]}>
      <span class="hours-info-icon"><TablerIcon src={calendarIcon} /></span>
      <div>
        <span>Periodo</span>
        <strong>{periodSummary}</strong>
      </div>
    </article>

    <article class:list={["hours-info-card", "hours-date-start", !hasStartDate && "is-null"]}>
      <span class="hours-info-icon"><TablerIcon src={playerPlayIcon} /></span>
      <div>
        <span>Inicio</span>
        <strong>{hasStartDate ? <time datetime={editValues.fecha_inicio ?? undefined}>{period.startLabel}</time> : 'Sin registrar'}</strong>
      </div>
    </article>

    {!isRecurring && (
      <article class:list={["hours-info-card", "hours-date-end", !hasEndDate && "is-null"]}>
        <span class="hours-info-icon"><TablerIcon src={flagIcon} /></span>
        <div>
          <span>Fin</span>
          <strong>{hasEndDate ? <time datetime={editValues.fecha_fin ?? undefined}>{period.endLabel}</time> : 'Sin registrar'}</strong>
        </div>
      </article>
    )}

  </div>

  {hourEntries.length > 1 && <dl class="launcher-hours-breakdown" aria-label="Horas por launcher">
    {hourEntries.map(entry => <div><dt>{entry.launcher}</dt><dd>{entry.minutos === null ? 'Sin registrar' : formatHoursDuration(entry.minutos / 60)}</dd></div>)}
  </dl>}
  {hourEntries.length > 1 && hourEntries.some(entry => entry.minutos === null) && <p class="launcher-hours-help">Total parcial: hay launchers sin horas registradas.</p>}

  <div class:list={["hours-secondary-grid", !hasHltbBreakdown && "is-goal-only"]}>
    <GameDetailHoursGoal metrics={metrics} estimated={editValues.horas_estimadas} />
    {hasHltbBreakdown && (
      <dl class="hours-breakdown-grid" aria-label="Desglose HLTB" style={`--hltb-count:${hltbReferences.length}`}>
        {hltbReferences.map(({ label, value }) => <div><dt>{label}</dt><dd>{formatHoursDuration(value)}</dd></div>)}
      </dl>
    )}
  </div>
  <GameDetailUsageBreakdown {metrics} />
</article>

<dialog class="edit-dialog" id="hours-edit-dialog">
  <div class="edit-dialog-body">
    <div class="edit-dialog-head">
      <h2>Editar horas y periodo</h2>
      <button class="edit-dialog-close" id="hours-edit-close" type="button" aria-label="Cerrar">×</button>
    </div>
    <p class="edit-dialog-error" id="hours-edit-error" hidden></p>
    <form id="hours-edit-form" data-slug={slug} data-hours-base={JSON.stringify(hourEntries)} data-recurring={isRecurring ? 'true' : 'false'}>
      <div id="hours-launcher-rows">{hourEntries.map(entry => <LauncherHourRow {entry} />)}</div>
      <template id="hours-launcher-template"><LauncherHourRow /></template>
      <datalist id="hours-launchers"><option value="Steam" /><option value="Epic Games" /><option value="HoYoPlay" /><option value="GOG" /><option value="Xbox" /><option value="Battle.net" /></datalist>
      <button class="edit-dialog-cancel" type="button" id="hours-launcher-add">Añadir launcher</button>
      <p class="launcher-hours-help">Introduce el contador acumulado de cada launcher. Deja ambos campos vacíos si no lo conoces. El total se calcula automáticamente.</p>
      <div class="launcher-hours-total"><span>Total registrado</span><strong id="hours-edit-total">{formatHoursDuration(metrics.realHours)}</strong></div>
      <div class="edit-field edit-field-checkbox">
        <FormCheckbox inputId="hours-edit-estimated" name="horas_estimadas" value="true" checked={editValues.horas_estimadas}>
          Estas horas son una estimación
        </FormCheckbox>
      </div>
      <fieldset class:list={["hours-period-fieldset", isRecurring && "is-open-ended"]}>
        <legend>Periodo de juego</legend>
        <div class="edit-field-row">
          <div class="edit-field">
            <label for="hours-edit-start">Inicio</label>
            <input id="hours-edit-start" name="fecha_inicio" type="date" value={editValues.fecha_inicio ?? ''} />
          </div>
          {!isRecurring && (
            <div class="edit-field">
              <label for="hours-edit-end">Fin</label>
              <input id="hours-edit-end" name="fecha_fin" type="date" value={editValues.fecha_fin ?? ''} />
            </div>
          )}
        </div>
      </fieldset>
      <div class="edit-dialog-actions">
        <button class="edit-dialog-cancel" id="hours-edit-cancel" type="button">Cancelar</button>
        <button class="edit-dialog-submit" id="hours-edit-submit" type="submit">Guardar cambios</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { initGameHoursEditor } from '../../scripts/game-hours-editor';
  initGameHoursEditor();
</script>
