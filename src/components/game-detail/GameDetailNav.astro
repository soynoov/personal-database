---
/**
 * GameDetailNav.astro — Barra de navegación sticky entre secciones.
 * Muestra links a Overview, Horas, Dinero, Estadísticas y opcionalmente DLCs.
 * Datos: hasDlcs computado en [slug].astro.
 */
import '../../styles/game-detail/nav.css';

interface Props {
  hasDlcs: boolean;
  hasOverviewDetails: boolean;
  isCompetitive: boolean;
}

const { hasDlcs, hasOverviewDetails, isCompetitive } = Astro.props;
---

<nav class="game-sections-nav" aria-label="Secciones del juego">
  <a class="is-active" aria-current="location" data-section-link href={hasOverviewDetails ? "#overview" : "#game-header"}>Resumen</a>
  <a data-section-link href="#hours">Horas</a>
  <a data-section-link href="#finance">Dinero</a>
  {isCompetitive && <a data-section-link href="#competitive">Rango</a>}
  <a data-section-link href="#technical">Datos</a>
  {hasDlcs && <a data-section-link href="#dlcs">DLCs</a>}
  <a data-section-link href="#metacritica">Metacrítica</a>
</nav>

<script>
  const sectionLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-section-link]'));
  const sectionById = new Map(
    sectionLinks
      .map((link) => [link.hash.slice(1), document.getElementById(link.hash.slice(1))] as const)
      .filter((entry): entry is [string, HTMLElement] => entry[1] instanceof HTMLElement),
  );

  const activateSection = (id: string) => {
    sectionLinks.forEach((link) => {
      const active = link.hash === `#${id}`;
      link.classList.toggle('is-active', active);
      if (active) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (visible?.target.id) activateSection(visible.target.id);
    },
    { rootMargin: '-20% 0px -65% 0px', threshold: [0, 0.2, 0.6] },
  );

  sectionById.forEach((section) => observer.observe(section));
</script>
