---
import '../../styles/game-detail/edit.css';
import '../../styles/game-detail/review-v2.css';
import type { GameCritique } from '../../lib/local-games';
import { getPublishedReview, getReviewProgress, getPersonalScoreMeaning, getScoreTone } from '../../lib/game-reviews';
import { boundedReviewNumber } from '../../lib/review-legacy';
import MetricCard from '../MetricCard.astro';
import GamePill from '../GamePill.astro';
import ReviewWizard from './ReviewWizard.astro';
import TablerIcon from '../TablerIcon.astro';
import editIcon from '@tabler/icons/outline/edit.svg?url';
import sparklesIcon from '@tabler/icons/outline/sparkles.svg?url';
import chevronIcon from '@tabler/icons/outline/chevron-right.svg?url';

interface Props {
  slug: string;
  critique: GameCritique | null;
  legacyScore: number | null;
  includeCommunity: boolean;
}
const { slug, critique, legacyScore, includeCommunity } = Astro.props;
const published = getPublishedReview(critique, legacyScore, includeCommunity);
const progress = getReviewProgress(critique, includeCommunity);
const totalWeight = progress.applicable.reduce((sum, item) => sum + item.weight, 0);
const format = (value: number | null) => value === null ? '—' : value.toLocaleString('es-ES', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
const metascore = boundedReviewNumber(critique?.metascore, 100);
const userscore = boundedReviewNumber(critique?.userscore, 10);
const radar = progress.applicable.map((item) => ({ label: item.shortLabel, value: item.normalized }));
---
<section class="game-metacritic panel review-v2" id="metacritica">
  <header class="game-metacritic-head">
    <div><span class="section-eyebrow">Crítica</span><h2>Valoración</h2></div>
    <div class="review-head-actions">
      {critique?.original === true && <GamePill label="Original"><TablerIcon src={sparklesIcon} /></GamePill>}
      <button class="game-edit-trigger metacritic-edit-trigger" id="metacritic-edit-trigger" type="button" aria-label="Editar mi valoración">
        <TablerIcon src={editIcon} />
      </button>
    </div>
  </header>

  <div class="review-bento">
    <div class="review-summary">
      <div class="review-personal">
        <MetricCard label="NooV Score" value={format(published.score)} unit="/ 10" context={published.source === 'anterior' ? critique?.ultima_completa ? 'Última nota completa · revisión pendiente' : 'Nota anterior · pendiente de completar v2' : published.source === 'v2' ? getPersonalScoreMeaning(published.score) : 'Aún sin valorar'} primary />
        {progress.missing.length > 0 && <button class="review-text-action" type="button" data-edit-target="metacritic-edit-trigger">
          {progress.answered.length > 0 ? `Completar ${progress.missing.length} áreas pendientes` : 'Empezar valoración'}
        </button>}
      </div>
      <div class="review-external">
        <div class={`is-${getScoreTone(userscore)}`}><MetricCard label="User score" value={`${format(userscore)} / 10`} context={userscore === null ? 'Sin dato de Metacritic' : 'Comunidad de Metacritic'} /></div>
        <div class={`is-${getScoreTone(metascore, 100)}`}><MetricCard label="Metascore" value={`${metascore === null ? '—' : metascore} / 100`} context={metascore === null ? 'Sin dato de Metacritic' : 'Crítica profesional'} /></div>
      </div>
    </div>

    <div class="review-profile">
      <div class="review-profile-head">
        <h3>De dónde viene tu nota</h3>
        <span>{progress.answered.length}/{progress.applicable.length} áreas</span>
      </div>
      <div class="review-profile-body">
        <figure class="review-radar" aria-describedby="review-radar-caption">
          <div class="review-radar-canvas">
            <canvas id="review-radar" data-review-radar={JSON.stringify(radar)} role="img" aria-label="Perfil de valoración. Los valores exactos están en la lista contigua."></canvas>
          </div>
          <figcaption id="review-radar-caption">Escala común 0–10 · no representa el peso de cada área.</figcaption>
        </figure>
        <dl class="review-values">
          {progress.criteria.map((item) => <div class:list={[item.value === null && 'is-pending']}>
            <dt>{item.shortLabel}</dt>
            <dd>{item.notApplicable ? 'No aplica' : item.value === null ? 'Pendiente' : <><strong>{item.value.toLocaleString('es-ES')}</strong><span> / {item.max}</span></>}</dd>
          </div>)}
        </dl>
      </div>
    </div>
  </div>

  <details class="review-calculation">
    <summary><TablerIcon src={chevronIcon} /><span>Cómo se calcula y qué significa</span><small>{published.source === 'v2' ? 'NooV Score v2' : 'Sin medias incompletas'}</small></summary>
    <div class="review-calculation-body">
      <p>Cada área se lleva a 0–10 y se pondera por su peso. «No aplica» se excluye y redistribuye su peso; una respuesta pendiente no cuenta como cero. Originalidad es una insignia y Diversión no añade bonus.</p>
      <div class="review-weights">{progress.applicable.map((item) => <span>{item.shortLabel} <strong>{(item.weight / totalWeight * 100).toLocaleString('es-ES', { maximumFractionDigits: 1 })}%</strong></span>)}</div>
      <p>El 10 exige el máximo en todas las áreas aplicables: prácticamente perfecto en lo que propone. Un 7 es bueno; un 8, muy bueno; un 9, excelente pero mejorable.</p>
      {critique?.migracion && <p>Respuestas importadas del sistema anterior: revisa sus nuevos significados. Rendimiento y Progresión no se han inventado. La nota y la mención anteriores quedan archivadas; la nota anterior se conserva hasta completar esta valoración.</p>}
      <a href="/criticas/#escala">Consultar todos los criterios y niveles</a>
    </div>
  </details>
</section>
<ReviewWizard slug={slug} critique={critique} includeCommunity={includeCommunity} />
<script>
  import { initReviewRadar } from '../../scripts/review-radar';
  initReviewRadar();
</script>
