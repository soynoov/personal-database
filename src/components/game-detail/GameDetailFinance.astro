---
import '../../styles/game-detail/shared.css';
import '../../styles/game-detail/finance.css';
import '../../styles/game-detail/edit.css';
import GameDetailMarket from './GameDetailMarket.astro';
import GameDetailFinanceNotice from './GameDetailFinanceNotice.astro';
import PurchaseBalance from './PurchaseBalance.astro';
import MetricCard from '../MetricCard.astro';
import type { GameMarketView } from '../../lib/game-market-view';
import { formatEuro, type GameValueMetrics } from '../../lib/game-finance';
import { getGameSpendScope } from '../../lib/game-spend-scope';
import { getPurchaseStoreOptions, normalizePurchaseStores } from '../../lib/purchase-stores';
import FormCheckbox from '../FormCheckbox.astro';
import TablerIcon from '../TablerIcon.astro';
import editIcon from '@tabler/icons/outline/edit.svg?url';
import infoIcon from '@tabler/icons/outline/info-circle.svg?url';

interface Props {
  slug: string;
  metrics: GameValueMetrics;
  market: GameMarketView;
  editValues: {
    precio_pagado: number | null;
    unidades_compradas: number;
    tiendas_compra: string[];
    plataforma: string | null;
    gasto_microtransacciones: number | null;
    tags: string[];
  };
}
const { slug, metrics, market, editValues } = Astro.props;
const isFreeToPlay = metrics.isFreeToPlay;
const purchaseStoreOptions = getPurchaseStoreOptions(editValues.plataforma);
const selectedPurchaseStore = normalizePurchaseStores(editValues.tiendas_compra)[0] ?? '';
const { purchaseBalance: purchases } = market;
const spendScope = getGameSpendScope(metrics, market);
---

<GameDetailFinanceNotice {market} />
<article class="analysis-panel analysis-panel-money" id="finance">
  <div class="section-title-row analysis-head">
    <div><span class="section-eyebrow">Calidad de compra</span><h2>Dinero</h2></div>
    <button class="game-edit-trigger game-edit-trigger-sm" id="money-edit-trigger" type="button" aria-label="Editar gasto registrado" aria-controls="money-edit-dialog" data-money-edit-trigger>
      <TablerIcon src={editIcon} />
    </button>
  </div>

  <div class="purchase-overview" data-purchase-state={purchases.balance.state} data-purchase-partial={purchases.partial}>
    <PurchaseBalance label="Balance de compra" balance={purchases.balance} partial={purchases.partial} />
    {purchases.paidTotal !== null && <>
      <MetricCard label="Pagado comparable" value={formatEuro(purchases.paidTotal)} context="Solo compras con ambos precios" />
      <MetricCard label="Precio de referencia" value={formatEuro(purchases.currentTotal)} context="Los mismos productos" />
    </>}
  </div>
  <p class="purchase-scope">{purchases.cohortLabel} · últimos precios registrados</p>
  {spendScope.differs && <p class="purchase-footnote" data-spend-reconciliation>
    <TablerIcon src={infoIcon} />
    <span>
      Gasto conocido total: <strong>{formatEuro(spendScope.total)}</strong> =
      {spendScope.comparable !== null && <> {formatEuro(spendScope.comparable)} comparables</>}
      {spendScope.unpaired > 0 && <> {spendScope.comparable !== null && '+ '}{formatEuro(spendScope.unpaired)} en compras sin precio de referencia</>}
      {spendScope.microtransactions > 0 && <> {(spendScope.comparable !== null || spendScope.unpaired > 0) && '+ '}{formatEuro(spendScope.microtransactions)} en micropagos</>}.
      {' '}Se usa para <a href="#hours">amortizar en Horas</a>{spendScope.provisional && ' (provisional)'}.
    </span>
  </p>}

  <GameDetailMarket {slug} {market} purchasedUnits={metrics.purchasedUnits} />
</article>

<dialog class="edit-dialog" id="money-edit-dialog">
  <div class="edit-dialog-body">
    <div class="edit-dialog-head">
      <h2>Editar dinero</h2>
      <button class="edit-dialog-close" id="money-edit-close" type="button" aria-label="Cerrar">×</button>
    </div>
    <p class="edit-dialog-error" id="money-edit-error" hidden></p>
    <form id="money-edit-form" data-slug={slug}>
      <div class="edit-field edit-field-checkbox">
        <FormCheckbox inputId="money-edit-free-to-play" name="free_to_play" checked={isFreeToPlay}>Free to Play</FormCheckbox>
      </div>
      <div class="edit-field-row money-base-fields" hidden={isFreeToPlay}>
        <div class="edit-field">
          <label for="money-edit-precio">Precio por copia (EUR)</label>
          <input id="money-edit-precio" name="precio_pagado" type="number" step="0.01" min="0" value={editValues.precio_pagado ?? ''} />
        </div>
        <div class="edit-field">
          <label for="money-edit-unidades">Copias compradas</label>
          <input id="money-edit-unidades" name="unidades_compradas" type="number" step="1" min="1" value={editValues.unidades_compradas} />
        </div>
      </div>
      <div class="edit-field money-base-fields" hidden={isFreeToPlay}>
        <label for="money-edit-store">Comprado en</label>
        <select class="purchase-store-select" id="money-edit-store" name="tiendas_compra">
          <option value="" selected={!selectedPurchaseStore}>Sin registrar</option>
          {purchaseStoreOptions.map((store) => (
            <option value={store} selected={selectedPurchaseStore === store}>{store}</option>
          ))}
        </select>
      </div>
      <div class="edit-field">
        <label for="money-edit-microtransacciones">Micropagos (EUR)</label>
        <input id="money-edit-microtransacciones" name="gasto_microtransacciones" type="number" step="0.01" min="0" value={editValues.gasto_microtransacciones ?? ''} />
      </div>
      <div class="edit-dialog-actions">
        <button class="edit-dialog-cancel" id="money-edit-cancel" type="button">Cancelar</button>
        <button class="edit-dialog-submit" id="money-edit-submit" type="submit">Guardar cambios</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { editorFetch } from '../../scripts/editor-auth';
  import { finishGameEdit } from '../../scripts/game-edit-feedback';
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-money-edit-trigger]');
  const dialog = document.getElementById('money-edit-dialog');
  const form = document.getElementById('money-edit-form');
  const errorBox = document.getElementById('money-edit-error');
  const submit = document.getElementById('money-edit-submit');
  if (triggers.length > 0 && dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement && errorBox instanceof HTMLElement && submit instanceof HTMLButtonElement) {
    const close = () => dialog.close();
    const free = document.getElementById('money-edit-free-to-play');
    const syncBaseFields = () => {
      const hidden = free instanceof HTMLInputElement && free.checked;
      document.querySelectorAll<HTMLElement>('.money-base-fields').forEach((field) => { field.hidden = hidden; });
    };
    free?.addEventListener('change', syncBaseFields);
    triggers.forEach((trigger) => trigger.addEventListener('click', () => { errorBox.hidden = true; dialog.showModal(); }));
    document.getElementById('money-edit-close')?.addEventListener('click', close);
    document.getElementById('money-edit-cancel')?.addEventListener('click', close);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      submit.disabled = true;
      submit.textContent = 'Guardando…';
      try {
        const response = await editorFetch(`/api/games/${form.dataset.slug ?? ''}/edit`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            precio_pagado: data.get('precio_pagado'),
            unidades_compradas: data.get('unidades_compradas'),
            tiendas_compra: free instanceof HTMLInputElement && free.checked ? [] : data.get('tiendas_compra'),
            gasto_microtransacciones: data.get('gasto_microtransacciones'),
            free_to_play: free instanceof HTMLInputElement && free.checked,
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || `HTTP ${response.status}`);
        finishGameEdit('finance', 'Dinero actualizado');
      } catch (error) {
        errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar.';
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Guardar cambios';
      }
    });
  }

  const syncButton = document.getElementById('dlc-sync-prices-btn');
  const syncStatus = document.getElementById('dlc-sync-prices-status');
  if (syncButton instanceof HTMLButtonElement && syncStatus instanceof HTMLElement) {
    syncButton.addEventListener('click', async () => {
      syncButton.disabled = true;
      syncStatus.textContent = 'Consultando…';
      try {
        const response = await editorFetch(`/api/games/${syncButton.dataset.slug ?? ''}/dlcs/sync-prices`, { method: 'POST' });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || `HTTP ${response.status}`);
        if (result.updated > 0) finishGameEdit('finance', 'Precios de DLC actualizados');
        else { syncStatus.textContent = result.message ?? 'Sin cambios'; syncButton.disabled = false; }
      } catch (error) {
        syncStatus.textContent = error instanceof Error ? error.message : 'No se pudo actualizar.';
        syncButton.disabled = false;
      }
    });
  }
</script>
