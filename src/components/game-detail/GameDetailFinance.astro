---
import '../../styles/game-detail/shared.css';
import '../../styles/game-detail/finance.css';
import '../../styles/game-detail/edit.css';
import {
  formatEuro,
  formatHoursDuration,
  type GameValueMetrics,
} from '../../lib/game-finance';
import { getPurchaseStoreOptions, normalizePurchaseStores } from '../../lib/purchase-stores';
import FormCheckbox from '../FormCheckbox.astro';
import TablerIcon from '../TablerIcon.astro';
import chartIcon from '@tabler/icons/outline/chart-line.svg?url';
import coinsIcon from '@tabler/icons/outline/coins.svg?url';
import editIcon from '@tabler/icons/outline/edit.svg?url';
import targetIcon from '@tabler/icons/outline/target-arrow.svg?url';

interface MoneyEditValues {
  precio_pagado: number | null;
  unidades_compradas: number;
  tiendas_compra: string[];
  plataforma: string | null;
  gasto_microtransacciones: number | null;
  tags: string[];
}

interface Props {
  slug: string;
  metrics: GameValueMetrics;
  paidUnitPrice: number | null;
  moneyChartPayload: object;
  moneyChartPoints: Array<{ label: string; value: number }>;
  dlcChartPayload: object | null;
  dlcChartPoints: Array<{ label: string; value: number }>;
  hasDlcs: boolean;
  marketCards: Array<{ label: string; value: string; note?: string; className?: string }>;
  editValues: MoneyEditValues;
}

const {
  slug,
  metrics,
  paidUnitPrice,
  moneyChartPayload,
  moneyChartPoints,
  dlcChartPayload,
  dlcChartPoints,
  hasDlcs,
  marketCards,
  editValues,
} = Astro.props;
const isFreeToPlay = editValues.tags.includes('free-to-play');
const purchaseStoreOptions = getPurchaseStoreOptions(editValues.plataforma);
const selectedPurchaseStores = normalizePurchaseStores(editValues.tiendas_compra);
const selectedPurchaseStore = selectedPurchaseStores[0] ?? '';
const progress = Math.max(0, Math.min(100, metrics.economicProgressPercent ?? 0));
const isAmortized = metrics.dataComplete && metrics.realHours !== null && (metrics.economicRemainingHours ?? 0) === 0;
const economicState = !metrics.dataComplete
  ? 'Datos incompletos'
  : metrics.realHours === null
    ? 'Sin horas registradas'
    : (metrics.economicRemainingHours ?? 0) > 0
      ? `Faltan ${formatHoursDuration(metrics.economicRemainingHours)}`
      : metrics.recordedSpend === 0
        ? 'Sin coste que amortizar'
        : 'Amortizado';
const economicMultipleLabel = !metrics.dataComplete || metrics.realHours === null
  ? '—'
  : metrics.recordedSpend === 0
    ? 'Sin coste'
    : `${metrics.economicMultiple?.toLocaleString('es-ES', { maximumFractionDigits: 2 }) ?? '0'}×`;
const economicProgressLabel = !metrics.dataComplete
  ? 'Datos incompletos'
  : metrics.recordedSpend === 0
    ? 'Sin meta económica'
    : metrics.economicProgressPercent === null
      ? 'Sin progreso calculable'
      : `${formatHoursDuration(metrics.weightedHours)} / ${formatHoursDuration(metrics.economicTargetHours)}`;
const baseBreakdown = metrics.baseSpend === null
  ? 'Pendiente'
  : metrics.isFreeToPlay
    ? formatEuro(0)
    : formatEuro(metrics.baseSpend);
const showBaseBreakdown = !metrics.isFreeToPlay;
const showDlcBreakdown = hasDlcs || metrics.acquiredDlcCount > 0;
const showMicroBreakdown = metrics.isFreeToPlay || metrics.microtransactionSpend > 0 || editValues.gasto_microtransacciones !== null;
const breakdownSourceCount = [showBaseBreakdown, showDlcBreakdown, showMicroBreakdown].filter(Boolean).length;
const showTotalBreakdown = breakdownSourceCount > 1;
const visibleMarketCards = marketCards.filter((card) => {
  if (card.label === 'DLC pendientes' && !hasDlcs) return false;
  if (metrics.isFreeToPlay) return card.label === 'DLC pendientes';
  return true;
});
const showBaseMarket = !metrics.isFreeToPlay && (
  moneyChartPoints.length > 0 || visibleMarketCards.some((card) => card.value !== '—')
);
const showDlcMarket = hasDlcs;
const showMarket = showBaseMarket || showDlcMarket;
const incompleteHeadline = metrics.incompleteReasons[0]?.replace(/\.$/, '') ?? 'Completa los datos de compra';
const incompleteDetail = metrics.incompleteReasons.slice(1).join(' ');
const incompleteActionLabel = metrics.baseSpend === null ? 'Registrar precio' : 'Completar gasto';
---

<article class="analysis-panel analysis-panel-money" id="finance">
  <div class="section-title-row analysis-head">
    <div>
      <span class="section-eyebrow">Rentabilidad</span>
      <h2>Dinero</h2>
    </div>
    <button class="game-edit-trigger game-edit-trigger-sm" id="money-edit-trigger" type="button" aria-label="Editar gasto registrado" aria-controls="money-edit-dialog" data-money-edit-trigger>
      <TablerIcon src={editIcon} />
    </button>
  </div>

  {metrics.dataComplete ? (
    <div class="finance-priority-grid">
      <article class:list={["finance-progress-card", isAmortized && "is-complete"]}>
        <div class="finance-progress-head">
          <span>Rentabilidad</span>
          <small>{economicProgressLabel}</small>
        </div>
        <strong class="finance-progress-multiple">{economicMultipleLabel}</strong>
        <span class="finance-progress-status">{economicState}</span>
        {metrics.economicProgressPercent !== null && metrics.recordedSpend > 0 && (
          <div class="value-progress" role="progressbar" aria-label="Progreso de la meta económica" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.round(progress)}>
            <span style={`--value-progress:${progress}%`}></span>
          </div>
        )}
      </article>

      <article class:list={["finance-goal-card", isAmortized && "is-complete"]}>
        <div class="finance-goal-primary">
          <div class="finance-goal-icon"><TablerIcon src={targetIcon} /></div>
          <div class="finance-goal-copy">
            <span>Meta económica</span>
            <strong>{formatHoursDuration(metrics.economicTargetHours)}</strong>
            <small>{economicState}</small>
          </div>
        </div>
        <div class="finance-goal-cost">
          <span>Gasto registrado</span>
          <strong>{formatEuro(metrics.recordedSpend)}</strong>
        </div>
      </article>
    </div>
  ) : (
    <section class="finance-incomplete-state" aria-labelledby="finance-incomplete-title">
      <div class="finance-goal-icon"><TablerIcon src={targetIcon} /></div>
      <div class="finance-incomplete-copy">
        <span>Rentabilidad pendiente</span>
        <strong id="finance-incomplete-title">{incompleteHeadline}</strong>
        {incompleteDetail && <small>{incompleteDetail}</small>}
      </div>
      <button class="finance-incomplete-action" type="button" aria-controls="money-edit-dialog" data-money-edit-trigger>{incompleteActionLabel}</button>
    </section>
  )}

  <div class="finance-kpi-grid">
    {metrics.costPerRealHour !== null && <article><span>Coste/h real</span><strong>{formatEuro(metrics.costPerRealHour)}/h</strong></article>}
    {metrics.adjustedCostPerHour !== null && <article><span>Coste/h ponderada</span><strong>{formatEuro(metrics.adjustedCostPerHour)}/h</strong></article>}
    {metrics.weightedHours !== null && <article><span>Horas ponderadas</span><strong>{formatHoursDuration(metrics.weightedHours)}</strong></article>}
    <article class:list={[!metrics.scoreComplete && "is-null"]}>
      <span>Bonus My Score</span>
      <strong>{metrics.scoreBonusPercent > 0 ? `+${metrics.scoreBonusPercent.toLocaleString('es-ES')}%` : 'Sin bonus'}</strong>
      <small>{metrics.scoreComplete ? `×${metrics.scoreMultiplier.toFixed(2).replace('.', ',')}` : 'Crítica incompleta'}</small>
    </article>
    {isAmortized && metrics.recordedSpend > 0 && (
      <article><span>Excedente</span><strong>{formatHoursDuration(metrics.economicSurplusHours)}</strong></article>
    )}
  </div>

  <section class:list={["finance-breakdown", breakdownSourceCount === 1 && "is-single-source"]} aria-labelledby="finance-breakdown-title">
    <div class="finance-breakdown-head">
      <span class="finance-breakdown-icon"><TablerIcon src={coinsIcon} /></span>
      <h3 id="finance-breakdown-title">Gasto registrado</h3>
    </div>
    <dl>
      {showBaseBreakdown && <div>
        <dt>Juego base</dt>
        <dd>{baseBreakdown}</dd>
        <dd class="finance-breakdown-note">{paidUnitPrice === null ? 'Sin precio pagado' : `${formatEuro(paidUnitPrice)} × ${metrics.purchasedUnits}`}</dd>
      </div>}
      {showDlcBreakdown && <div><dt>DLC adquiridos</dt><dd>{formatEuro(metrics.dlcSpend)}</dd><dd class="finance-breakdown-note">{metrics.acquiredDlcCount} registrados</dd></div>}
      {showMicroBreakdown && <div class:list={[breakdownSourceCount === 1 && "finance-breakdown-featured"]}><dt>Micropagos</dt><dd>{formatEuro(metrics.microtransactionSpend)}</dd><dd class="finance-breakdown-note">Gasto dentro del juego</dd></div>}
      {showTotalBreakdown && <div class="finance-breakdown-total"><dt>Total</dt><dd>{metrics.dataComplete ? formatEuro(metrics.recordedSpend) : 'Incompleto'}</dd><dd class="finance-breakdown-note">1 € = 1 h ponderada</dd></div>}
    </dl>
  </section>

  {showMarket && (
    <details class="value-secondary-details finance-market-details">
      <summary><TablerIcon src={chartIcon} /><span>Mercado</span></summary>
      <div class:list={["finance-market-grid", !showBaseMarket && "is-dlc-only"]}>
        {showBaseMarket && <div class="chart-visual-card chart-visual-card-money">
          <div class="chart-header"><strong>Precios del juego base</strong><span class="chart-badge">{moneyChartPoints.length} valores</span></div>
          {moneyChartPoints.length >= 2 ? (
            <div class="chart-canvas-wrap chart-canvas-wrap-money"><canvas id="money-detail-chart" data-chart={JSON.stringify(moneyChartPayload)}></canvas></div>
          ) : <div class="chart-empty">Sin referencias suficientes</div>}
        </div>}
        {showBaseMarket && <dl class="finance-market-values">
          {visibleMarketCards.map((card) => <div class:list={[card.value === '—' && "is-null", card.className]}><dt>{card.label}</dt><dd>{card.value}</dd>{card.note && <dd class="finance-market-note">{card.note}</dd>}</div>)}
        </dl>}
        {showDlcMarket && (
          <div class="chart-visual-card chart-visual-card-dlc">
            <div class="chart-header finance-market-dlc-head">
              <strong>Precios de DLC</strong>
              <div class="finance-market-dlc-actions"><span class="chart-badge">{dlcChartPoints.length} valores</span><button type="button" class="dlc-sync-prices-btn" id="dlc-sync-prices-btn" data-slug={slug}>Actualizar</button></div>
            </div>
            <span class="dlc-sync-prices-status" id="dlc-sync-prices-status" aria-live="polite"></span>
            {dlcChartPoints.length >= 2 ? (
              <div class="chart-canvas-wrap"><canvas id="dlc-finance-chart" data-chart={JSON.stringify(dlcChartPayload)}></canvas></div>
            ) : <div class="chart-empty">Sin referencias suficientes</div>}
          </div>
        )}
      </div>
    </details>
  )}
</article>

<dialog class="edit-dialog" id="money-edit-dialog">
  <div class="edit-dialog-body">
    <div class="edit-dialog-head">
      <h2>Editar dinero</h2>
      <button class="edit-dialog-close" id="money-edit-close" type="button" aria-label="Cerrar">×</button>
    </div>
    <p class="edit-dialog-error" id="money-edit-error" hidden></p>
    <form id="money-edit-form" data-slug={slug}>
      <div class="edit-field edit-field-checkbox">
        <FormCheckbox inputId="money-edit-free-to-play" name="free_to_play" checked={isFreeToPlay}>Free to Play</FormCheckbox>
      </div>
      <div class="edit-field-row money-base-fields" hidden={isFreeToPlay}>
        <div class="edit-field">
          <label for="money-edit-precio">Precio por copia (EUR)</label>
          <input id="money-edit-precio" name="precio_pagado" type="number" step="0.01" min="0" value={editValues.precio_pagado ?? ''} />
        </div>
        <div class="edit-field">
          <label for="money-edit-unidades">Copias compradas</label>
          <input id="money-edit-unidades" name="unidades_compradas" type="number" step="1" min="1" value={editValues.unidades_compradas} />
        </div>
      </div>
      <div class="edit-field money-base-fields" hidden={isFreeToPlay}>
        <label for="money-edit-store">Comprado en</label>
        <select class="purchase-store-select" id="money-edit-store" name="tiendas_compra">
          <option value="" selected={!selectedPurchaseStore}>Sin registrar</option>
          {purchaseStoreOptions.map((store) => (
            <option value={store} selected={selectedPurchaseStore === store}>{store}</option>
          ))}
        </select>
      </div>
      <div class="edit-field">
        <label for="money-edit-microtransacciones">Micropagos (EUR)</label>
        <input id="money-edit-microtransacciones" name="gasto_microtransacciones" type="number" step="0.01" min="0" value={editValues.gasto_microtransacciones ?? ''} />
      </div>
      <div class="edit-dialog-actions">
        <button class="edit-dialog-cancel" id="money-edit-cancel" type="button">Cancelar</button>
        <button class="edit-dialog-submit" id="money-edit-submit" type="submit">Guardar cambios</button>
      </div>
    </form>
  </div>
</dialog>

<script>
  import { editorFetch } from '../../scripts/editor-auth';
  import { finishGameEdit } from '../../scripts/game-edit-feedback';
  const triggers = document.querySelectorAll<HTMLButtonElement>('[data-money-edit-trigger]');
  const dialog = document.getElementById('money-edit-dialog');
  const form = document.getElementById('money-edit-form');
  const errorBox = document.getElementById('money-edit-error');
  const submit = document.getElementById('money-edit-submit');
  if (triggers.length > 0 && dialog instanceof HTMLDialogElement && form instanceof HTMLFormElement && errorBox instanceof HTMLElement && submit instanceof HTMLButtonElement) {
    const close = () => dialog.close();
    const free = document.getElementById('money-edit-free-to-play');
    const syncBaseFields = () => {
      const hidden = free instanceof HTMLInputElement && free.checked;
      document.querySelectorAll<HTMLElement>('.money-base-fields').forEach((field) => { field.hidden = hidden; });
    };
    free?.addEventListener('change', syncBaseFields);
    triggers.forEach((trigger) => trigger.addEventListener('click', () => { errorBox.hidden = true; dialog.showModal(); }));
    document.getElementById('money-edit-close')?.addEventListener('click', close);
    document.getElementById('money-edit-cancel')?.addEventListener('click', close);
    dialog.addEventListener('click', (event) => { if (event.target === dialog) close(); });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      submit.disabled = true;
      submit.textContent = 'Guardando…';
      try {
        const response = await editorFetch(`/api/games/${form.dataset.slug ?? ''}/edit`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            precio_pagado: data.get('precio_pagado'),
            unidades_compradas: data.get('unidades_compradas'),
            tiendas_compra: free instanceof HTMLInputElement && free.checked ? [] : data.get('tiendas_compra'),
            gasto_microtransacciones: data.get('gasto_microtransacciones'),
            free_to_play: free instanceof HTMLInputElement && free.checked,
          }),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || `HTTP ${response.status}`);
        finishGameEdit('finance', 'Dinero actualizado');
      } catch (error) {
        errorBox.textContent = error instanceof Error ? error.message : 'No se pudo guardar.';
        errorBox.hidden = false;
        submit.disabled = false;
        submit.textContent = 'Guardar cambios';
      }
    });
  }

  const syncButton = document.getElementById('dlc-sync-prices-btn');
  const syncStatus = document.getElementById('dlc-sync-prices-status');
  if (syncButton instanceof HTMLButtonElement && syncStatus instanceof HTMLElement) {
    syncButton.addEventListener('click', async () => {
      syncButton.disabled = true;
      syncStatus.textContent = 'Consultando…';
      try {
        const response = await editorFetch(`/api/games/${syncButton.dataset.slug ?? ''}/dlcs/sync-prices`, { method: 'POST' });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || !result.ok) throw new Error(result.error || `HTTP ${response.status}`);
        if (result.updated > 0) finishGameEdit('finance', 'Precios de DLC actualizados');
        else { syncStatus.textContent = result.message ?? 'Sin cambios'; syncButton.disabled = false; }
      } catch (error) {
        syncStatus.textContent = error instanceof Error ? error.message : 'No se pudo actualizar.';
        syncButton.disabled = false;
      }
    });
  }
</script>
