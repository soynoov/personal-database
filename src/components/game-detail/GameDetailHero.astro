---
/**
 * GameDetailHero.astro — Hero cinematográfico de la página de detalle de juego.
 * Muestra la portada, el título y los badges principales sobre el fondo del juego.
 * Datos: todos computados en [slug].astro y recibidos como props.
 */
import '../../styles/game-detail/hero.css';
import GamePill from '../GamePill.astro';
import TablerIcon from '../TablerIcon.astro';
import trophyIcon from '@tabler/icons/outline/trophy.svg?url';

interface Props {
  title: string;
  coverUrl: string;
  heroCoverStyle: string;
  status: string;
  launcher: string;
  platform: string;
  tagBadges: Array<{ value: string; label: string }>;
  goldenCompletionLabel?: string | null;
}

const {
  title,
  coverUrl,
  heroCoverStyle,
  status,
  launcher,
  platform,
  tagBadges,
  goldenCompletionLabel = null,
} = Astro.props;

---

<section class="game-hero-rich game-hero-cinematic" id="game-header" style={heroCoverStyle}>
  <section class="game-intro-panel game-overview-card game-overview-card-cinematic">
    <div class="game-overview-media">
      <div class="game-poster-stack">
        <img
          class="game-poster-image"
          src={coverUrl}
          alt={`Caratula de ${title}`}
          loading="lazy"
        />
      </div>
    </div>

    <div class="game-overview-copy">
      <h1>{title}</h1>
      <div class="badges game-page-badges">
        <GamePill kind="status" value={status} />
        <GamePill kind="launcher" value={launcher} />
        <GamePill kind="platform" value={platform} />
        {goldenCompletionLabel && (
          <GamePill kind="achievement" value={goldenCompletionLabel}>
            <TablerIcon src={trophyIcon} />
          </GamePill>
        )}
        {tagBadges.map((tag) => (
          <GamePill kind="tag" value={tag.value} label={tag.label} />
        ))}
      </div>
    </div>
  </section>
</section>
