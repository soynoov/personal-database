---
/**
 * GameDetailHero.astro — Hero cinematográfico de la página de detalle de juego.
 * Muestra la portada, título, badges (estado, launcher, plataforma, tags) y resumen.
 * Datos: todos computados en [slug].astro y recibidos como props.
 */
import '../../styles/game-detail/hero.css';

interface Props {
  title: string;
  coverUrl: string;
  heroCoverStyle: string;
  statusBadge: { class: string; label: string };
  launcherBadge: { class: string; html: string };
  platformBadge: { class: string; label: string };
  tagBadges: Array<{ value: string; label: string }>;
  genres: string;
  tagsLabel: string;
  modesLabel: string;
}

const {
  title,
  coverUrl,
  heroCoverStyle,
  statusBadge,
  launcherBadge,
  platformBadge,
  tagBadges,
  genres,
  tagsLabel,
  modesLabel,
} = Astro.props;

const tagBadgeClasses: Record<string, string> = {
  "free-to-play": "badge-tag-free",
  competitivo: "badge-tag-competitive",
  "early-access": "badge-tag-early",
  indie: "badge-tag-indie",
  modpacks: "badge-tag-modpacks",
};
---

<section class="game-hero-rich game-hero-cinematic" id="game-header" style={heroCoverStyle}>
  <section class="game-intro-panel game-overview-card game-overview-card-cinematic">
    <div class="game-overview-media">
      <div class="game-poster-stack">
        <img
          class="game-poster-image"
          src={coverUrl}
          alt={`Caratula de ${title}`}
          loading="lazy"
        />
      </div>
    </div>

    <div class="game-overview-copy">
      <div class="eyebrow">Ficha de juego</div>
      <h1>{title}</h1>
      <div class="badges game-page-badges">
        <span class={`badge ${statusBadge.class}`}>{statusBadge.label}</span>
        <span class={`badge ${launcherBadge.class}`} set:html={launcherBadge.html} />
        <span class={`badge ${platformBadge.class}`}>{platformBadge.label}</span>
        {tagBadges.map((tag) => (
          <span class:list={["badge", tagBadgeClasses[tag.value]]}>{tag.label}</span>
        ))}
      </div>
      <dl class="game-hero-facts" aria-label="Datos principales">
        <div>
          <dt>Géneros</dt>
          <dd>{genres !== "-" ? genres : "Sin datos"}</dd>
        </div>
        <div>
          <dt>Etiquetas</dt>
          <dd>{tagsLabel}</dd>
        </div>
        <div>
          <dt>Modo</dt>
          <dd>{modesLabel}</dd>
        </div>
      </dl>
    </div>
  </section>
</section>
