---
import type { LauncherHours } from '../../lib/game-hours.mjs';
interface Props { entry?: LauncherHours; }
const { entry = { launcher: '', minutos: null } } = Astro.props;
---
<div class="launcher-hour-row edit-field" data-hour-row>
  <label>Launcher<input data-hour-launcher aria-label="Launcher" list="hours-launchers" maxlength="80" required value={entry.launcher} /></label>
  <label>Horas<input data-hour-hours aria-label="Horas" type="number" min="0" max="1000000" step="1" value={entry.minutos === null ? '' : Math.floor(entry.minutos / 60)} /></label>
  <label>Minutos<input data-hour-minutes aria-label="Minutos" type="number" min="0" max="59" step="1" value={entry.minutos === null ? '' : entry.minutos % 60} /></label>
  <button type="button" data-remove-hour aria-label="Quitar contador">×</button>
</div>
